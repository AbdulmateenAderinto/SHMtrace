stroke":"none","strokeWidth":0,"radius":0},{"id":"omviesgkubg","type":"rect","x":731,"y":1161,"w":50,"h":2,"rot":0,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":1},{"id":"omviesgkubh","type":"rect","x":764,"y":1144.2,"w":34,"h":1.6,"rot":-90,"fill":"#6f7b88","stroke":"none","strokeWidth":0,"radius":0.8},{"id":"omviesgkubi","type":"rect","x":781,"y":1127,"w":96,"h":2,"rot":0,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":1},{"id":"omviesgkubj","type":"rect","x":775,"y":1155.2,"w":12,"h":1.6,"rot":-90,"fill":"#6f7b88","stroke":"none","strokeWidth":0,"radius":0.8},{"id":"omviesgkubk","type":"rect","x":781,"y":1149,"w":121.66666666666663,"h":2,"rot":0,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":1},{"id":"omviesgkubl","type":"rect","x":775,"y":1167.2,"w":12,"h":1.6,"rot":90,"fill":"#6f7b88","stroke":"none","strokeWidth":0,"radius":0.8},{"id":"omviesgkubm","type":"rect","x":781,"y":1173,"w":74,"h":2,"rot":0,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":1},{"id":"omviesgkubn","type":"rect","x":764,"y":1178.2,"w":34,"h":1.6,"rot":90,"fill":"#6f7b88","stroke":"none","strokeWidth":0,"radius":0.8},{"id":"omviesgkubo","type":"rect","x":779.67,"y":1195,"w":112,"h":2,"rot":0,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":1},{"id":"omviesgkubp","type":"rect","x":932.6666666666666,"y":1054,"w":211.66666666666666,"h":228,"rot":0,"fill":"#ffffff","stroke":"#b4bec8","strokeWidth":1.6,"radius":10},{"id":"omviesgkubq","type":"text","text":"Spectrum and","x":944.6666666666666,"y":1064,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":120,"h":24},{"id":"omviesgkubr","type":"text","text":"motif shares","x":944.6666666666666,"y":1086,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":106,"h":24},{"id":"omviesgkubs","type":"text","text":"G:C / A:T, Ts / Tv,","x":944.6666666666666,"y":1212,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","w":146,"h":24},{"id":"omviesgkubt","type":"text","text":"WRC/GYW, WA/TW","x":944.6666666666666,"y":1233,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","w":163,"h":24},{"id":"omviesgkubu","type":"rect","x":972.6666666666666,"y":1120,"w":50,"h":28,"rot":0,"fill":"#2c5d8a","stroke":"none","strokeWidth":0,"radius":0},{"id":"omviesgkubv","type":"rect","x":972.6666666666666,"y":1148,"w":50,"h":20,"rot":0,"fill":"#7fa7cf","stroke":"none","strokeWidth":0,"radius":0},{"id":"omviesgkubw","type":"rect","x":972.6666666666666,"y":1168,"w":50,"h":32,"rot":0,"fill":"#d9952b","stroke":"none","strokeWidth":0,"radius":0},{"id":"omviesgkubx","type":"rect","x":1042.6666666666665,"y":1120,"w":50,"h":52.800000000000004,"rot":0,"fill":"#2c5d8a","stroke":"none","strokeWidth":0,"radius":0},{"id":"omviesgkuby","type":"rect","x":1042.6666666666665,"y":1172.8,"w":50,"h":23.2,"rot":0,"fill":"#7fa7cf","stroke":"none","strokeWidth":0,"radius":0},{"id":"omviesgkubz","type":"rect","x":1042.6666666666665,"y":1196,"w":50,"h":4,"rot":0,"fill":"#d9952b","stroke":"none","strokeWidth":0,"radius":0},{"id":"omviesgkuc0","type":"rect","x":1158.3333333333333,"y":1054,"w":211.66666666666666,"h":228,"rot":0,"fill":"#ffffff","stroke":"#b4bec8","strokeWidth":1.6,"radius":10},{"id":"omviesgkuc1","type":"text","text":"Reports, app","x":1170.3333333333333,"y":1064,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":111,"h":24},{"id":"omviesgkuc2","type":"text","text":"and command line","x":1170.3333333333333,"y":1086,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":156,"h":24},{"id":"omviesgkuc3","type":"text","text":"HTML report, tables,","x":1170.3333333333333,"y":1212,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","w":164,"h":24},{"id":"omviesgkuc4","type":"text","text":"project files","x":1170.3333333333333,"y":1233,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","w":93,"h":24},{"id":"omviesgkuc5","type":"image","src":"data:image/svg+xml;base64,","x":1230.1666666666665,"y":1118,"w":68,"h":68,"rot":0,"nw":1024}],"alt":"Figure 1. SHMtrace: control-calibrated somatic hypermutation calling, from inputs and read preparation through calling, quality checks and outputs."}],"uploads":[],"assets":{},"plotStyle":{"family":"Arial","fontSize":7,"tickSize":6.6,"labelSize":7,"titleSize":7,"legendSize":6.6,"minScriptPt":6,"axisLineWidth":0.8,"lineWidth":1.4,"markerSize":4,"palette":["#274b7e","#7a4f9a","#1f6f8b","#a3621b","#9a3439","#4a5562"]},"plotPrelude":{"python":"# ruff: noqa: F821  (plt comes from the SciCanvas plot worker)\n# Shared by the CRM code plots: the figures' plot prelude (SciCanvas 2.1), run before every plot in the app and by\n# build.js. Plots render at their printed size, so sizes below are printed points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return d * d\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n"},"journal":{"id":"cell","widthMM":174,"commercial":false,"guide":false}}