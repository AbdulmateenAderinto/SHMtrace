,32],\\\"ko\\\":[6.67,4.26,9.09,9.3,13.04,10.26,15.62,11.54],\\\"pub_wt\\\":32.51,\\\"pub_ko\\\":8.27,\\\"p\\\":9.687037896556261e-11},{\\\"label\\\":\\\"A:T Ts\\\",\\\"wt\\\":[25.29,16.09,18.6,21.13,17.92,14.04,24.32,24.49,28.09,20.34,18.87,16],\\\"ko\\\":[20,27.66,22.73,23.26,23.91,20.51,17.19,36.54],\\\"pub_wt\\\":18.68,\\\"pub_ko\\\":18.55,\\\"p\\\":0.13929817995872312},{\\\"label\\\":\\\"C:G Tv\\\",\\\"wt\\\":[12.64,14.94,12.79,15.49,22.64,17.54,20.27,10.2,19.1,13.56,16.98,20],\\\"ko\\\":[11.11,8.51,4.55,6.98,6.52,2.56,7.81,7.69],\\\"pub_wt\\\":16.01,\\\"pub_ko\\\":5.65,\\\"p\\\":0.000007694165705126035},{\\\"label\\\":\\\"C:G Ts\\\",\\\"wt\\\":[22.99,24.14,34.88,28.17,29.25,29.82,24.32,28.57,22.47,27.12,32.08,32],\\\"ko\\\":[62.22,59.57,63.64,60.47,56.52,66.67,59.38,44.23],\\\"pub_wt\\\":32.81,\\\"pub_ko\\\":67.54,\\\"p\\\":1.2259337589644386e-10}],\\\"arm\\\":{\\\"Samhd1_WT\\\":[\\\"#274b7e\\\",\\\"#6d9ad0\\\"],\\\"Samhd1_KO\\\":[\\\"#7a4f9a\\\",\\\"#bda3d4\\\"],\\\"Samhd1_KO_UGI\\\":[\\\"#1f6f8b\\\",\\\"#8cc3d6\\\"],\\\"Msh2_KO\\\":[\\\"#a3621b\\\",\\\"#e0b483\\\"],\\\"Msh2_Samhd1_KO\\\":[\\\"#4a5562\\\",\\\"#b9c2cc\\\"]}}\")\n\nfig, ax = plt.subplots()\n(we, wf), (ke, kf) = D[\"arm\"][\"Samhd1_WT\"], D[\"arm\"][\"Samhd1_KO\"]\nfor i, c in enumerate(D[\"C\"]):\n    strip(ax, i - 0.2, c[\"wt\"], wf, we, d=4.4, spread=0.09)\n    strip(ax, i + 0.2, c[\"ko\"], kf, ke, d=4.4, spread=0.09)\n    ax.scatter([i - 0.2], [c[\"pub_wt\"]], s=area(5.2), facecolor=\"white\", edgecolor=we, linewidth=lw(1.0), marker=\"s\", zorder=5)\n    ax.scatter([i + 0.2], [c[\"pub_ko\"]], s=area(5.2), facecolor=\"white\", edgecolor=ke, linewidth=lw(1.0), marker=\"s\", zorder=5)\n    p = c[\"p\"]\n    ax.text(i, 70, \"****\" if p < 1e-4 else (\"*\" if p < 0.05 else \"ns\"), ha=\"center\", va=\"bottom\",\n            color=INK if p < 0.05 else MID)\nax.set_xticks(range(4), [c[\"label\"].replace(\" \", \"\\n\") for c in D[\"C\"]])\nax.set_xlim(-0.6, 3.6); ax.set_ylim(0, 104); ax.set_yticks(