ily: 'Arial', 'Helvetica', 'DejaVu Sans', sans-serif; text-anchor: middle; fill: #4a5562\" x=\"215.38609\" y=\"317.863646\" transform=\"rotate(-0 215.38609 317.863646)\">Mutations per clone</text>\n    </g>\n   </g>\n   <g id=\"cp0_matplotlib.axis_2\">\n    <g id=\"cp0_ytick_1\">\n     <g id=\"cp0_line2d_5\"/>\n     <g id=\"cp0_text_6\">\n      <text style=\"font-style: italic; font-size: 14.050457px; font-family: 'Arial', 'Helvetica', 'DejaVu Sans', sans-serif; text-anchor: end; fill: #4a5562\" x=\"96.32162\" y=\"244.671141\" transform=\"rotate(-0 96.32162 244.671141)\">Msh2 Samhd1</text>\n     </g>\n    </g>\n    <g id=\"cp0_ytick_2\">\n     <g id=\"cp0_line2d_6\"/>\n     <g id=\"cp0_text_7\">\n      <text style=\"font-style: italic; font-size: 14.050457px; font-family: 'Arial', 'Helvetica', 'DejaVu Sans', sans-serif; text-anchor: end; fill: #a3621b\" x=\"96.32162\" y=\"193.245849\" transform=\"rotate(-0 96.32162 193.245849)\">Msh2</text>\n     </g>\n    </g>\n    <g id=\"cp0_ytick_3\">\n     <g id=\"cp0_line2d_7\"/>\n     <g id=\"cp0_text_8\">\n      <text style=\"font-style: italic; font-size: 14.050457px; font-family: 'Arial', 'Helvetica', 'DejaVu Sans', sans-serif; text-anchor: end; fill: #1f6f8b\" x=\"96.32162\" y=\"141.820557\" transform=\"rotate(-0 96.32162 141.820557)\">Samhd1 + UGI</text>\n     </g>\n    </g>\n    <g id=\"cp0_ytick_4\">\n     <g id=\"cp0_line2d_8\"/>\n     <g id=\"cp0_text_9\">\n      <text style=\"font-style: italic; font-size: 14.050457px; font-family: 'Arial', 'Helvetica', 'DejaVu Sans', sans-serif; text-anchor: end; fill: #7a4f9a\" x=\"96.32162\" y=\"90.395265\" transform=\"rotate(-0 96.32162 90.395265)\">Samhd1</text>\n     </g>\n    </g>\n    <g id=\"cp0_ytick_5\">\n     <g id=\"cp0_line2d_9\"/>\n     <g id=\"cp0_text_10\">\n      <text style=\"font-size: 14.050457px; font-family: 'Arial', 'Helvetica', 'DejaVu Sans', sans-serif; text-anchor: end; fill: #274b7e\" x=\"96.32162\" y=\"38.969974\" transform=\"rotate(-0 96.32162 38.969974