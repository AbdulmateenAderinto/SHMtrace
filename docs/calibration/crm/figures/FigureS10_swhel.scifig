{"version":2,"pages":[{"id":"crm-figS10","name":"Figure S10","width":1400,"height":528,"background":"#ffffff","objects":[{"id":"omvbg24er2","type":"text","text":"A","x":4,"y":2,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":20,"h":31},{"id":"omvbg24es3","type":"text","text":"Mutations per sequence","x":38,"y":6,"rot":0,"fontSize":19.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":225,"h":27},{"id":"plot1","type":"icon","iconId":"upload:plot0","x":20,"y":40,"w":440,"h":432,"rot":0,"name":"A: mutations per sequence","plot":{"lang":"python","code":"# The page prints at 174 mm from 1,400 units, so lines and markers are drawn PAGE times their printed size.\nPAGE = 2.1288\nfor _k in (\"axes.linewidth\", \"xtick.major.width\", \"ytick.major.width\", \"xtick.minor.width\", \"ytick.minor.width\",\n           \"xtick.major.size\", \"ytick.major.size\", \"xtick.minor.size\", \"ytick.minor.size\", \"lines.linewidth\",\n           \"lines.markersize\", \"lines.markeredgewidth\", \"patch.linewidth\", \"grid.linewidth\", \"hatch.linewidth\",\n           \"errorbar.capsize\", \"xtick.major.pad\", \"ytick.major.pad\", \"axes.labelpad\"):\n    plt.rcParams[_k] = plt.rcParams[_k] * PAGE\nplt.rcParams[\"xtick.labelsize\"] = plt.rcParams[\"ytick.labelsize\"] = FONT_SIZE * 6.6 / 7\nplt.rcParams[\"legend.fontsize\"] = FONT_SIZE * 6.6 / 7\nplt.rcParams[\"axes.titlesize\"] = FONT_SIZE\n\n# ruff: noqa: F821  (plt, PAGE and FONT_SIZE come from the SciCanvas plot worker and build.js's preamble)\n# Shared by the CRM code plots (SciCanvas 2.0). Prepended to each plot's code by the builders, so every plot in a\n# .scifig re-runs on its own in SciCanvas. PAGE and the rcParams scaling come from build.js's preamble: sizes below\n# are the printed sizes, in points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return (d * PAGE) ** 2\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w * PAGE\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n\nD = json.loads(\"{\\\"A\\\":[{\\\"group\\\":\\\"Samhd1_WT\\\",\\\"label\\\":\\\"wt/het\\\",\\\"pub\\\":1.79,\\\"sh\\\":1.782,\\\"pub_seqs\\\":565,\\\"sh_seqs\\\":565,\\\"pub_muts\\\":1012,\\\"sh_muts\\\":1007},{\\\"group\\\":\\\"Samhd1_KO\\\",\\\"label\\\":\\\"Samhd1\\\",\\\"pub\\\":1.4,\\\"sh\\\":1.401,\\\"pub_seqs\\\":354,\\\"sh_seqs\\\":354,\\\"pub_muts\\\":496,\\\"sh_muts\\\":496},{\\\"group\\\":\\\"Samhd1_KO_UGI\\\",\\\"label\\\":\\\"Samhd1+UGI\\\",\\\"pub\\\":2.48,\\\"sh\\\":2.472,\\\"pub_seqs\\\":218,\\\"sh_seqs\\\":218,\\\"pub_muts\\\":541,\\\"sh_muts\\\":539},{\\\"group\\\":\\\"Msh2_KO\\\",\\\"label\\\":\\\"Msh2\\\",\\\"pub\\\":1.08,\\\"sh\\\":1.083,\\\"pub_seqs\\\":446,\\\"sh_seqs\\\":445,\\\"pub_muts\\\":480,\\\"sh_muts\\\":482},{\\\"group\\\":\\\"Msh2_Samhd1_KO\\\",\\\"label\\\":\\\"Msh2 Samhd1\\\",\\\"pub\\\":1.31,\\\"sh\\\":1.315,\\\"pub_seqs\\\":213,\\\"sh_seqs\\\":213,\\\"pub_muts\\\":280,\\\"sh_muts\\\":280}],\\\"arm\\\":{\\\"Samhd1_WT\\\":[\\\"#274b7e\\\",\\\"#6d9ad0\\\"],\\\"Samhd1_KO\\\":[\\\"#7a4f9a\\\",\\\"#bda3d4\\\"],\\\"Samhd1_KO_UGI\\\":[\\\"#1f6f8b\\\",\\\"#8cc3d6\\\"],\\\"Msh2_KO\\\":[\\\"#a3621b\\\",\\\"#e0b483\\\"],\\\"Msh2_Samhd1_KO\\\":[\\\"#4a5562\\\",\\\"#b9c2cc\\\"]}}\")\n\nfig, ax = plt.subplots()\nrows = D[\"A\"][::-1]                        # wild type at the top\nfor i, a in enumerate(rows):\n    e, f = D[\"arm\"][a[\"group\"]]\n    ax.scatter(a[\"sh\"], i + 0.14, s=area(5.5), facecolor=f, edgecolor=e, linewidth=lw(0.7), zorder=3)\n    ax.scatter(a[\"pub\"], i - 0.14, s=area(5.0), facecolor=\"white\", edgecolor=e, linewidth=lw(0.8), marker=\"s\", zorder=3)\nnames = {\"wt/het\": \"wt/het\", \"Samhd1\": \"Samhd1\", \"Samhd1+UGI\": \"Samhd1 + UGI\", \"Msh2\": \"Msh2\", \"Msh2 Samhd1\": \"Msh2 Samhd1\"}\nax.set_yticks(range(len(rows)), [names[a[\"label\"]] for a in rows])\nfor lab, a in zip(ax.get_yticklabels(), rows):\n    lab.set_color(D[\"arm\"][a[\"group\"]][0])\n    if a[\"label\"] != \"wt/het\":\n        lab.set_fontstyle(\"italic\")\nax.set_xlim(0, 3.2); ax.set_ylim(-0.6, len(rows) - 0.4)\nax.set_xlabel(\"Mutations per clone\")\nax.tick_params(axis=\"y\", length=0)\nax.scatter([], [], s=area(5.5), facecolor=\"#b9c2cc\", edgecolor=INK, linewidth=lw(0.7), label=\"SHMtrace\")\nax.scatter([], [], s=area(5.0), facecolor=\"white\", edgecolor=INK, linewidth=lw(0.8), marker=\"s\", label=\"Published\")\nax.legend(loc=\"lower right\", frameon=False, handletextpad=0.2, borderaxespad=0.1, labelspacing=0.3)\n","w":440,"h":432,"files":[],"error":null,"textEdits":{}}},{"id":"omvbg24pw4","type":"text","text":"B","x":460,"y":2,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":20,"h":31},{"id":"omvbg24pw5","type":"text","text":"Substitution spectrum","x":494,"y":6,"rot":0,"fontSize":19.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":203,"h":27},{"id":"plot2","type":"icon","iconId":"upload:plot1","x":476,"y":40,"w":352,"h":432,"rot":0,"name":"B: substitution spectrum","plot":{"lang":"python","code":"# The page prints at 174 mm from 1,400 units, so lines and markers are drawn PAGE times their printed size.\nPAGE = 2.1288\nfor _k in (\"axes.linewidth\", \"xtick.major.width\", \"ytick.major.width\", \"xtick.minor.width\", \"ytick.minor.width\",\n           \"xtick.major.size\", \"ytick.major.size\", \"xtick.minor.size\", \"ytick.minor.size\", \"lines.linewidth\",\n           \"lines.markersize\", \"lines.markeredgewidth\", \"patch.linewidth\", \"grid.linewidth\", \"hatch.linewidth\",\n           \"errorbar.capsize\", \"xtick.major.pad\", \"ytick.major.pad\", \"axes.labelpad\"):\n    plt.rcParams[_k] = plt.rcParams[_k] * PAGE\nplt.rcParams[\"xtick.labelsize\"] = plt.rcParams[\"ytick.labelsize\"] = FONT_SIZE * 6.6 / 7\nplt.rcParams[\"legend.fontsize\"] = FONT_SIZE * 6.6 / 7\nplt.rcParams[\"axes.titlesize\"] = FONT_SIZE\n\n# ruff: noqa: F821  (plt, PAGE and FONT_SIZE come from the SciCanvas plot worker and build.js's preamble)\n# Shared by the CRM code plots (SciCanvas 2.0). Prepended to each plot's code by the builders, so every plot in a\n# .scifig re-runs on its own in SciCanvas. PAGE and the rcParams scaling come from build.js's preamble: sizes below\n# are the printed sizes, in points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return (d * PAGE) ** 2\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w * PAGE\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n\nD = json.loads(\"{\\\"B\\\":[[16.798,16.783,\\\"Samhd1_WT\\\",\\\"A>T\\\"],[8.597,8.64,\\\"Samhd1_WT\\\",\\\"A>C\\\"],[12.352,12.413,\\\"Samhd1_WT\\\",\\\"A>G\\\"],[4.348,4.369,\\\"Samhd1_WT\\\",\\\"T>A\\\"],[6.324,6.356,\\\"Samhd1_WT\\\",\\\"T>C\\\"],[2.767,2.781,\\\"Samhd1_WT\\\",\\\"T>G\\\"],[2.668,2.681,\\\"Samhd1_WT\\\",\\\"C>A\\\"],[14.032,14.002,\\\"Samhd1_WT\\\",\\\"C>T\\\"],[2.569,2.582,\\\"Samhd1_WT\\\",\\\"C>G\\\"],[18.775,18.669,\\\"Samhd1_WT\\\",\\\"G>A\\\"],[3.458,3.476,\\\"Samhd1_WT\\\",\\\"G>T\\\"],[7.312,7.249,\\\"Samhd1_WT\\\",\\\"G>C\\\"],[3.024,3.024,\\\"Samhd1_KO\\\",\\\"A>T\\\"],[1.411,1.411,\\\"Samhd1_KO\\\",\\\"A>C\\\"],[12.097,12.097,\\\"Samhd1_KO\\\",\\\"A>G\\\"],[2.218,2.218,\\\"Samhd1_KO\\\",\\\"T>A\\\"],[6.452,6.452,\\\"Samhd1_KO\\\",\\\"T>C\\\"],[1.613,1.613,\\\"Samhd1_KO\\\",\\\"T>G\\\"],[0.403,0.403,\\\"Samhd1_KO\\\",\\\"C>A\\\"],[29.032,29.032,\\\"Samhd1_KO\\\",\\\"C>T\\\"],[2.016,2.016,\\\"Samhd1_KO\\\",\\\"C>G\\\"],[38.508,38.508,\\\"Samhd1_KO\\\",\\\"G>A\\\"],[0.806,0.806,\\\"Samhd1_KO\\\",\\\"G>T\\\"],[2.419,2.419,\\\"Samhd1_KO\\\",\\\"G>C\\\"],[3.697,3.711,\\\"Samhd1_KO_UGI\\\",\\\"A>T\\\"],[2.218,2.226,\\\"Samhd1_KO_UGI\\\",\\\"A>C\\\"],[11.275,11.317,\\\"Samhd1_KO_UGI\\\",\\\"A>G\\\"],[1.109,1.113,\\\"Samhd1_KO_UGI\\\",\\\"T>A\\\"],[6.285,6.308,\\\"Samhd1_KO_UGI\\\",\\\"T>C\\\"],[1.479,1.484,\\\"Samhd1_KO_UGI\\\",\\\"T>G\\\"],[0.185,0.186,\\\"Samhd1_KO_UGI\\\",\\\"C>A\\\"],[30.129,30.241,\\\"Samhd1_KO_UGI\\\",\\\"C>T\\\"],[0,0,\\\"Samhd1_KO_UGI\\\",\\\"C>G\\\"],[43.438,43.228,\\\"Samhd1_KO_UGI\\\",\\\"G>A\\\"],[0.185,0.186,\\\"Samhd1_KO_UGI\\\",\\\"G>T\\\"],[0,0,\\\"Samhd1_KO_UGI\\\",\\\"G>C\\\"],[1.042,1.037,\\\"Msh2_KO\\\",\\\"A>T\\\"],[0.625,0.622,\\\"Msh2_KO\\\",\\\"A>C\\\"],[1.042,1.037,\\\"Msh2_KO\\\",\\\"A>G\\\"],[0.417,0.415,\\\"Msh2_KO\\\",\\\"T>A\\\"],[0.417,0.415,\\\"Msh2_KO\\\",\\\"T>C\\\"],[0,0,\\\"Msh2_KO\\\",\\\"T>G\\\"],[1.458,1.452,\\\"Msh2_KO\\\",\\\"C>A\\\"],[43.75,43.776,\\\"Msh2_KO\\\",\\\"C>T\\\"],[1.042,1.037,\\\"Msh2_KO\\\",\\\"C>G\\\"],[38.125,38.174,\\\"Msh2_KO\\\",\\\"G>A\\\"],[3.75,3.734,\\\"Msh2_KO\\\",\\\"G>T\\\"],[8.333,8.299,\\\"Msh2_KO\\\",\\\"G>C\\\"],[0.357,0.357,\\\"Msh2_Samhd1_KO\\\",\\\"A>T\\\"],[0.714,0.714,\\\"Msh2_Samhd1_KO\\\",\\\"A>C\\\"],[1.071,1.071,\\\"Msh2_Samhd1_KO\\\",\\\"A>G\\\"],[0.357,0.357,\\\"Msh2_Samhd1_KO\\\",\\\"T>A\\\"],[0.357,0.357,\\\"Msh2_Samhd1_KO\\\",\\\"T>C\\\"],[0,0,\\\"Msh2_Samhd1_KO\\\",\\\"T>G\\\"],[1.786,1.786,\\\"Msh2_Samhd1_KO\\\",\\\"C>A\\\"],[43.571,43.571,\\\"Msh2_Samhd1_KO\\\",\\\"C>T\\\"],[0.714,0.714,\\\"Msh2_Samhd1_KO\\\",\\\"C>G\\\"],[46.071,46.071,\\\"Msh2_Samhd1_KO\\\",\\\"G>A\\\"],[1.071,1.071,\\\"Msh2_Samhd1_KO\\\",\\\"G>T\\\"],[3.929,3.929,\\\"Msh2_Samhd1_KO\\\",\\\"G>C\\\"]],\\\"r\\\":1,\\\"arm\\\":{\\\"Samhd1_WT\\\":[\\\"#274b7e\\\",\\\"#6d9ad0\\\"],\\\"Samhd1_KO\\\":[\\\"#7a4f9a\\\",\\\"#bda3d4\\\"],\\\"Samhd1_KO_UGI\\\":[\\\"#1f6f8b\\\",\\\"#8cc3d6\\\"],\\\"Msh2_KO\\\":[\\\"#a3621b\\\",\\\"#e0b483\\\"],\\\"Msh2_Samhd1_KO\\\":[\\\"#4a5562\\\",\\\"#b9c2cc\\\"]}}\")\n\nfig, ax = plt.subplots()\nax.plot([0, 49], [0, 49], color=SOFT, linewidth=lw(0.6), linestyle=(0, (3, 2)), zorder=1)\nfor x, y, g, t in D[\"B\"]:\n    e, f = D[\"arm\"][g]\n    ax.scatter(x, y, s=area(4.6), facecolor=f, edgecolor=e, linewidth=lw(0.6), zorder=3)\nax.set_xlim(0, 49); ax.set_ylim(0, 49)\nax.set_xticks([0, 20, 40]); ax.set_yticks([0, 20, 40])\nax.set_xlabel(\"Published (% of mutations)\"); ax.set_ylabel(\"SHMtrace (% of mutations)\")\nax.text(0.04, 0.96, f\"r = {D['r']:.4f}\\n12 types × 5 arms\", transform=ax.transAxes, va=\"top\", color=MID)\n","w":352,"h":432,"files":[],"error":null,"textEdits":{}}},{"id":"omvbg25266","type":"text","text":"C","x":828,"y":2,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":22,"h":31},{"id":"omvbg25267","type":"text","text":"The four classes tested","x":862,"y":6,"rot":0,"fontSize":19.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":218,"h":27},{"id":"plot3","type":"icon","iconId":"upload:plot2","x":844,"y":40,"w":350,"h":432,"rot":0,"name":"C: the four classes tested","plot":{"lang":"python","code":"# The page prints at 174 mm from 1,400 units, so lines and markers are drawn PAGE times their printed size.\nPAGE = 2.1288\nfor _k in (\"axes.linewidth\", \"xtick.major.width\", \"ytick.major.width\", \"xtick.minor.width\", \"ytick.minor.width\",\n           \"xtick.major.size\", \"ytick.major.size\", \"xtick.minor.size\", \"ytick.minor.size\", \"lines.linewidth\",\n           \"lines.markersize\", \"lines.markeredgewidth\", \"patch.linewidth\", \"grid.linewidth\", \"hatch.linewidth\",\n           \"errorbar.capsize\", \"xtick.major.pad\", \"ytick.major.pad\", \"axes.labelpad\"):\n    plt.rcParams[_k] = plt.rcParams[_k] * PAGE\nplt.rcParams[\"xtick.labelsize\"] = plt.rcParams[\"ytick.labelsize\"] = FONT_SIZE * 6.6 / 7\nplt.rcParams[\"legend.fontsize\"] = FONT_SIZE * 6.6 / 7\nplt.rcParams[\"axes.titlesize\"] = FONT_SIZE\n\n# ruff: noqa: F821  (plt, PAGE and FONT_SIZE come from the SciCanvas plot worker and build.js's preamble)\n# Shared by the CRM code plots (SciCanvas 2.0). Prepended to each plot's code by the builders, so every plot in a\n# .scifig re-runs on its own in SciCanvas. PAGE and the rcParams scaling come from build.js's preamble: sizes below\n# are the printed sizes, in points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return (d * PAGE) ** 2\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w * PAGE\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n\nD = json.loads(\"{\\\"C\\\":[{\\\"label\\\":\\\"A:T Tv\\\",\\\"wt\\\":[39.08,44.83,33.72,35.21,30.19,38.6,31.08,36.73,30.34,38.98,32.08,32],\\\"ko\\\":[6.67,4.26,9.09,9.3,13.04,10.26,15.62,11.54],\\\"pub_wt\\\":32.51,\\\"pub_ko\\\":8.27,\\\"p\\\":9.687037896556261e-11},{\\\"label\\\":\\\"A:T Ts\\\",\\\"wt\\\":[25.29,16.09,18.6,21.13,17.92,14.04,24.32,24.49,28.09,20.34,18.87,16],\\\"ko\\\":[20,27.66,22.73,23.26,23.91,20.51,17.19,36.54],\\\"pub_wt\\\":18.68,\\\"pub_ko\\\":18.55,\\\"p\\\":0.13929817995872312},{\\\"label\\\":\\\"C:G Tv\\\",\\\"wt\\\":[12.64,14.94,12.79,15.49,22.64,17.54,20.27,10.2,19.1,13.56,16.98,20],\\\"ko\\\":[11.11,8.51,4.55,6.98,6.52,2.56,7.81,7.69],\\\"pub_wt\\\":16.01,\\\"pub_ko\\\":5.65,\\\"p\\\":0.000007694165705126035},{\\\"label\\\":\\\"C:G Ts\\\",\\\"wt\\\":[22.99,24.14,34.88,28.17,29.25,29.82,24.32,28.57,22.47,27.12,32.08,32],\\\"ko\\\":[62.22,59.57,63.64,60.47,56.52,66.67,59.38,44.23],\\\"pub_wt\\\":32.81,\\\"pub_ko\\\":67.54,\\\"p\\\":1.2259337589644386e-10}],\\\"arm\\\":{\\\"Samhd1_WT\\\":[\\\"#274b7e\\\",\\\"#6d9ad0\\\"],\\\"Samhd1_KO\\\":[\\\"#7a4f9a\\\",\\\"#bda3d4\\\"],\\\"Samhd1_KO_UGI\\\":[\\\"#1f6f8b\\\",\\\"#8cc3d6\\\"],\\\"Msh2_KO\\\":[\\\"#a3621b\\\",\\\"#e0b483\\\"],\\\"Msh2_Samhd1_KO\\\":[\\\"#4a5562\\\",\\\"#b9c2cc\\\"]}}\")\n\nfig, ax = plt.subplots()\n(we, wf), (ke, kf) = D[\"arm\"][\"Samhd1_WT\"], D[\"arm\"][\"Samhd1_KO\"]\nfor i, c in enumerate(D[\"C\"]):\n    strip(ax, i - 0.2, c[\"wt\"], wf, we, d=4.4, spread=0.09)\n    strip(ax, i + 0.2, c[\"ko\"], kf, ke, d=4.4, spread=0.09)\n    ax.scatter([i - 0.2], [c[\"pub_wt\"]], s=area(5.2), facecolor=\"white\", edgecolor=we, linewidth=lw(1.0), marker=\"s\", zorder=5)\n    ax.scatter([i + 0.2], [c[\"pub_ko\"]], s=area(5.2), facecolor=\"white\", edgecolor=ke, linewidth=lw(1.0), marker=\"s\", zorder=5)\n    p = c[\"p\"]\n    ax.text(i, 70, \"****\" if p < 1e-4 else (\"*\" if p < 0.05 else \"ns\"), ha=\"center\", va=\"bottom\",\n            color=INK if p < 0.05 else MID)\nax.set_xticks(range(4), [c[\"label\"].replace(\" \", \"\\n\") for c in D[\"C\"]])\nax.set_xlim(-0.6, 3.6); ax.set_ylim(0, 104); ax.set_yticks([0, 20, 40, 60])\nax.set_ylabel(\"% of mutations\")\nax.scatter([], [], s=area(4.4), facecolor=wf, edgecolor=we, linewidth=lw(0.6), label=\"wt/het\")\nax.scatter([], [], s=area(4.4), facecolor=kf, edgecolor=ke, linewidth=lw(0.6), label=\"Samhd1 Δ/Δ\")\nax.scatter([], [], s=area(5.2), facecolor=\"white\", edgecolor=INK, linewidth=lw(1.0), marker=\"s\", label=\"published\")\nleg = ax.legend(loc=\"upper left\", frameon=False, handletextpad=0.1, borderaxespad=0.0, labelspacing=0.2)\nleg.get_texts()[1].set_fontstyle(\"italic\")\n","w":350,"h":432,"files":[],"error":null,"textEdits":{}}},{"id":"omvbg25e08","type":"text","text":"D","x":1136,"y":2,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":22,"h":31},{"id":"omvbg25e09","type":"text","text":"Claims","x":1170,"y":6,"rot":0,"fontSize":19.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":68,"h":27},{"id":"omvbg25e0a","type":"text","text":"Pub.","x":1257,"y":90,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"right","bold":true,"w":43,"h":24},{"id":"omvbg25e0b","type":"text","text":"SHMtrace","x":1313,"y":90,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"right","bold":true,"w":87,"h":24},{"id":"omvbg25e1c","type":"path","x":1204,"y":116,"w":196,"h":1,"w0":196,"h0":1,"rot":0,"nodes":[{"x":0,"y":0},{"x":196,"y":0}],"closed":false,"fill":"none","stroke":"#8a96a3","strokeWidth":1.6,"cap":"butt"},{"id":"omvbg25e1d","type":"text","text":"A:T transversions","x":1204,"y":130,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":141,"h":24},{"id":"omvbg25e1e","type":"text","text":"down ****","x":1222,"y":154,"rot":0,"fontSize":17.5,"color":"#a3621b","family":"arial","align":"right","w":78,"h":24},{"id":"omvbg25e1f","type":"text","text":"down ****","x":1322,"y":154,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"right","w":78,"h":24},{"id":"omvbg25e1g","type":"text","text":"A:T transitions","x":1204,"y":180,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":116,"h":24},{"id":"omvbg25e1h","type":"text","text":"unchanged","x":1209,"y":204,"rot":0,"fontSize":17.5,"color":"#a3621b","family":"arial","align":"right","w":91,"h":24},{"id":"omvbg25e1i","type":"text","text":"unchanged","x":1309,"y":204,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"right","w":91,"h":24},{"id":"omvbg25e1j","type":"text","text":"C:G transversions","x":1204,"y":230,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":145,"h":24},{"id":"omvbg25e1k","type":"text","text":"down ****","x":1222,"y":254,"rot":0,"fontSize":17.5,"color":"#a3621b","family":"arial","align":"right","w":78,"h":24},{"id":"omvbg25e1l","type":"text","text":"down ****","x":1322,"y":254,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"right","w":78,"h":24},{"id":"omvbg25e1m","type":"text","text":"C:G transitions","x":1204,"y":280,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":120,"h":24},{"id":"omvbg25e1n","type":"text","text":"up **","x":1258,"y":304,"rot":0,"fontSize":17.5,"color":"#a3621b","family":"arial","align":"right","w":42,"h":24},{"id":"omvbg25e1o","type":"text","text":"up ****","x":1344,"y":304,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"right","w":56,"h":24},{"id":"omvbg25e1p","type":"text","text":"Total mutation","x":1204,"y":330,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":115,"h":24},{"id":"omvbg25e1q","type":"text","text":"lower, ns","x":1225,"y":354,"rot":0,"fontSize":17.5,"color":"#a3621b","family":"arial","align":"right","w":75,"h":24},{"id":"omvbg25e1r","type":"text","text":"lower ****","x":1322,"y":354,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"right","w":78,"h":24},{"id":"omvbg25e1s","type":"text","text":"2,804 of the 2,809 mutations the paper counts; r = 1.0000 over the 60 spectrum cells of (B); 1,795 clones, 40 animals, 2 s.","x":92,"y":478,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":949,"h":24}],"alt":"Figure S10. A published Sanger study from another laboratory re-analysed automatically: mutations per sequence, the substitution spectrum, the four mutation classes the paper tests, and its claims against what SHMtrace finds."}],"uploads":[],"assets":{"upload:plot0":{"svg":"<g stroke-linejoin=\"round\" stroke-linecap=\"butt\">\n \n <defs>\n  \n </defs>\n <g id=\"cp0_figure_1\">\n  <g id=\"cp0_patch_1\">\n   <path d=\"M 0 324 \nL 330 324 \nL 330 0 \nL 0 0 \nL 0 324 \nz\n\" style=\"fill: none\"/>\n  </g>\n  <g id=\"cp0_axes_1\">\n   <g id=\"cp0_patch_2\">\n    <path d=\"M 103.77242 270.411758 \nL 326.99976 270.411758 \nL 326.99976 3.00024 \nL 103.77242 3.00024 \nL 103.77242 270.411758 \nz\n\" style=\"fill: none\"/>\n   </g>\n   <g id=\"cp0_PathCollection_1\"/>\n   <g id=\"cp0_PathCollection_2\"/>\n   <g id=\"cp0_matplotlib.axis_1\">\n    <g id=\"cp0_xtick_1\">\n     <g id=\"cp0_line2d_1\">\n      <defs>\n       <path id=\"cp0_ma65babcce5\" d=\"M 0 0 \nL 0 7.4508 \n\" style=\"stroke: #1d2733; stroke-width: 1.70304\"/>\n      </defs>\n      <g>\n       <use xlink:href=\"#cp0_ma65babcce5\" x=\"103.77242\" y=\"270.411758\" style=