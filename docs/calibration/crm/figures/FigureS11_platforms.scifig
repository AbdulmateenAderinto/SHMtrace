x":956,"y":381,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":374,"h":24},{"id":"omvb5y4fa37","type":"text","text":"of mutations in the first 450 bp, falling 7-fold","x":956,"y":403.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":343,"h":24},{"id":"omvb5y4fa38","type":"text","text":"to the last 250 bp (Figure 6A)","x":956,"y":426,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":231,"h":24},{"id":"omvb5y4fa39","type":"text","text":"Clones and mutation trees","x":956,"y":462.5,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":221,"h":24},{"id":"omvb5y4fa3a","type":"text","text":"clones of each mouse, and their mutations","x":956,"y":485.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":333,"h":24},{"id":"omvb5y4fa3b","type":"text","text":"ordered into trees (Figures 6 and S10)","x":956,"y":508,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":301,"h":24},{"id":"omvb5y4fa3c","type":"text","text":"Calls at a known false-discovery rate","x":956,"y":544.5,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":307,"h":24},{"id":"omvb5y4fa3d","type":"text","text":"each candidate tested against the controls,","x":956,"y":567.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":337,"h":24},{"id":"omvb5y4fa3e","type":"text","text":"the threshold set by them as decoys; single-read","x":956,"y":590,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":381,"h":24},{"id":"omvb5y4fa3f","type":"text","text":"mutations as one background-subtracted estimate","x":956,"y":612.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":393,"h":24}],"alt":"Figure S11. What Sanger clones and nanopore reads can each measure, and what both measure alike in the same mice."}],"uploads":[],"assets":[]}