gn":"left","bold":true,"w":248,"h":24},{"id":"omvb5y4fa2l","type":"text","text":"the AID-null clones' error rate (about 20 per","x":36,"y":590,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":340,"h":24},{"id":"omvb5y4fa2m","type":"text","text":"10⁵ bases at Q ≥ 20 in both published studies),","x":36,"y":612.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":370,"h":24},{"id":"omvb5y4fa2n","type":"text","text":"and how many of each animal's calls it explains","x":36,"y":635,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":372,"h":24},{"id":"omvb5y4fa2o","type":"rect","x":480,"y":306,"w":440,"h":428,"rot":0,"fill":"#ffffff","stroke":"#b4bec8","strokeWidth":1.6,"radius":10},{"id":"omvb5y4fa2p","type":"text","text":"From both, and they agree","x":496,"y":318,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":261,"h":28},{"id":"omvb5y4fa2q","type":"text","text":"Wild type against AID-null","x":496,"y":358,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":217,"h":24},{"id":"omvb5y4fa2r","type":"text","text":"Sanger 38-fold; nanopore at least 141-fold","x":496,"y":381,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":332,"h":24},{"id":"omvb5y4fa2s","type":"text","text":"Substitution spectrum","x":496,"y":417.5,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":183,"h":24},{"id":"omvb5y4fa2t","type":"text","text":"r = 0.92 (95% CI 0.74–0.98), slope 0.97","x":496,"y":440.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":311,"h":24},{"id":"omvb5y4fa2u","type":"text","text":"Position along the window","x":496,"y":477,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":219,"h":24},{"id":"omvb5y4fa2v","type":"text","text":"r = 0.94 in 25-bp bins","x":496,"y":500,"rot":0,"fontSize":1