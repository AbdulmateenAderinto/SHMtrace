","align":"left","w":359,"h":24},{"id":"omvfrxwpv99","type":"text","text":"mutations among 500 reads. Compare densities","x":496,"y":1310.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":377,"h":24},{"id":"omvfrxwpv9a","type":"text","text":"within a platform, not between.","x":496,"y":1333,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":242,"h":24},{"id":"omvfrxwpv9b","type":"rect","x":940,"y":930,"w":440,"h":428,"rot":0,"fill":"#eef5f8","stroke":"#b3d0db","strokeWidth":1.6,"radius":10},{"id":"omvfrxwpv9c","type":"text","text":"From the nanopore reads here","x":956,"y":942,"rot":0,"fontSize":20.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":299,"h":28},{"id":"omvfrxwpv9d","type":"text","text":"The whole amplicon","x":956,"y":982,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":169,"h":24},{"id":"omvfrxwpv9e","type":"text","text":"positions 90–1,230: 229-fold over controls; 69%","x":956,"y":1005,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":374,"h":24},{"id":"omvfrxwpv9f","type":"text","text":"of mutations in the first 450 bp, falling 7-fold","x":956,"y":1027.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":343,"h":24},{"id":"omvfrxwpv9g","type":"text","text":"to the last 250 bp (Figure 6A)","x":956,"y":1050,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":231,"h":24},{"id":"omvfrxwpv9h","type":"text","text":"Clones and mutation trees","x":956,"y":1086.5,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":221,"h":24},{"id":"omvfrxwpv9i","type":"text","text":"clones of each mouse, and their mutations","x":956,"y":1109.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":333,"h":24},{"id":"omvfrxwpv9j","type":"text","text":"ordered into trees (Figures 6 and S11)","x":956,"y":1132,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":301,"h":24},{"id":"omvfrxwpv9k","type":"text","text":"Calls at an estimated false-discovery rate","x":956,"y":1168.5,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":344,"h":24},{"id":"omvfrxwpv9l","type":"text","text":"each candidate tested against the controls,","x":956,"y":1191.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":337,"h":24},{"id":"omvfrxwpv9m","type":"text","text":"the threshold set by them as decoys; single-read","x":956,"y":1214,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":381,"h":24},{"id":"omvfrxwpv9n","type":"text","text":"mutations not called, as one background-","x":956,"y":1236.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":325,"h":24},{"id":"omvfrxwpv9o","type":"text","text":"subtracted estimate","x":956,"y":1259,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":157,"h":24}],"alt":"Figure S12. What Sanger clones and nanopore reads can each measure, how Illumina read pairs are merged and analyzed, and what Sanger and nanopore measure alike in the same mice."}],"uploads":[],"assets":{},"plotStyle":{"family":"Arial","fontSize":7,"tickSize":6.6,"labelSize":7,"titleSize":7,"legendSize":6.6,"minScriptPt":6,"axisLineWidth":0.8,"lineWidth":1.4,"markerSize":4,"palette":["#274b7e","#7a4f9a","#1f6f8b","#a3621b","#9a3439","#4a5562"]},"plotPrelude":{"python":"# ruff: noqa: F821  (plt comes from the SciCanvas plot worker)\n# Shared by the CRM code plots: the figures' plot prelude (SciCanvas 2.1), run before every plot in the app and by\n# build.js. Plots render at their printed size, so sizes below are printed points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return d * d\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n"},"journal":{"id":"cell","widthMM":174,"commercial":false,"guide":false}}