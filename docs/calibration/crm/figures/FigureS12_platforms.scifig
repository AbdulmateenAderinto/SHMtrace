bp median","x":1224,"y":420,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":135,"h":24},{"id":"omvfsd4wu7s","type":"text","text":"the join, its microhomology and any inserted bases are read, not inferred;","x":760,"y":488,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":571,"h":24},{"id":"omvfsd4wu7t","type":"text","text":"reads per unique junction run 1.1–23.3, so counts track PCR recovery,","x":760,"y":510.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":550,"h":24},{"id":"omvfsd4wu7u","type":"text","text":"not switching efficiency","x":760,"y":533,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":183,"h":24},{"id":"omvfsd4wu7v","type":"text","text":"Microhomology at the join","x":760,"y":576,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":216,"h":24},{"id":"omvfsd4wu7w","type":"text","text":"blunt","x":760,"y":601,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":42,"h":24},{"id":"omvfsd4wu7z","type":"rect","x":892,"y":604,"w":21.6,"h":12,"rot":0,"fill":"#9a3439","stroke":"none","strokeWidth":0,"radius":2},{"id":"omvfsd4wu80","type":"text","text":"14.4%","x":919.6,"y":601,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":54,"h":24},{"id":"omvfsd4wu81","type":"text","text":"1–3 nt","x":760,"y":623,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":53,"h":24},{"id":"omvfsd4wu84","type":"rect","x":892,"y":626,"w":57.15,"h":12,"rot":0,"fill":"#9a3439","stroke":"none","strokeWidth":0,"radius":2},{"id":"omvfsd4wu85","type":"text","text":"38.1%","x":955.15,"y":623,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":54,"h":24},{"id":"omvfsd4wu86","type":"text","text":"≥ 4 nt","x":760,"y":645,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":48,"h":24},{"id":"omvfsd4wu89","type":"