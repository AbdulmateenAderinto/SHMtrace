0,"rot":0,"fontSize":17.5,"color":"#3d5a80","family":"arial","align":"left","w":75,"h":24},{"id":"omvclgjli6w","type":"text","text":"J","x":831,"y":530,"rot":0,"fontSize":17.5,"color":"#3d5a80","family":"arial","align":"left","w":13,"h":24},{"id":"omvclgjli6z","type":"text","text":"H","x":840,"y":536,"rot":0,"fontSize":17.5,"color":"#3d5a80","family":"arial","align":"left","w":17,"h":24},{"id":"omvclgjli72","type":"text","text":"4 (Ldha)","x":853,"y":530,"rot":0,"fontSize":17.5,"color":"#3d5a80","family":"arial","align":"left","w":70,"h":24},{"id":"omvclgjli75","type":"rect","x":948,"y":534,"w":21.7,"h":14,"rot":0,"fill":"#3d5a80","stroke":"none","strokeWidth":0,"radius":2},{"id":"omvclgjli76","type":"text","text":"70 bp","x":977.7,"y":530,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":48,"h":24},{"id":"omvclgjli77","type":"text","text":"Illumina settings: minimap2 sr preset; error gate 0.02 per base;","x":760,"y":576,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":491,"h":24},{"id":"omvclgjli78","type":"text","text":"minimum alignment ≤ 100 bp; then the same control test and FDR.","x":760,"y":598.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":520,"h":24},{"id":"omvclgjli79","type":"text","text":"The Ldha and CH12F3 files carry a flat Q30 (SRA), so their error","x":760,"y":621,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":504,"h":24},{"id":"omvclgjli7a","type":"text","text":"model has a single quality level; the Ramos files keep binned ones.","x":760,"y":643.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":525,"h":24},{"id":"omvclgjli7b","type":"rect","x":20,"y":698,"w":440,"h":428,"rot":0,"fill":"#fbf4ec","stroke":"#e2c8a6","strokeWidth":1.6,"radius":10},{"id":"omvclgjli7c","type":"text","text":"From the Sanger clones here","x":36,"y":710,"rot":0,"fontSize":20.5,"color":"#a3621b","family":"arial","align":"left","bold":true,"w":286,"h":28},{"id":"omvclgjli7d","type":"text","text":"Each molecule's own mutations","x":36,"y":750,"rot":0,"fontSize":17.5,"color":"#a3621b","family":"arial","align":"left","bold":true,"w":264,"h":24},{"id":"omvclgjli7e","type":"text","text":"the mutation load of every clone, the share of","x":36,"y":773,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":355,"h":24},{"id":"omvclgjli7f","type":"text","text":"clones mutated, and frequency as published:","x":36,"y":795.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":352,"h":24},{"id":"omvclgjli7g","type":"text","text":"unique mutations over clones × a fixed length","x":36,"y":818,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":356,"h":24},{"id":"omvclgjli7h","type":"text","text":"Bookkeeping checks","x":36,"y":854.5,"rot":0,"fontSize":17.5,"color":"#a3621b","family":"arial","align":"left","bold":true,"w":175,"h":24},{"id":"omvclgjli7i","type":"text","text":"copied traces, clones filed under two mice,","x":36,"y":877.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":334,"h":24},{"id":"omvclgjli7j","type":"text","text":"mutated clones filed as controls, mislabeled","x":36,"y":900,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":343,"h":24},{"id":"omvclgjli7k","type":"text","text":"tubes (Figure S7)","x":36,"y":922.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":140,"h":24},{"id":"omvclgjli7l","type":"text","text":"Error reported, not subtracted","x":36,"y":959,"rot":0,"fontSize":17.5,"color":"#a3621b","family":"arial","align":"left","bold":true,"w":248,"h":24},{"id":"omvclgjli7m","type":"text","text":"the AID-null clones' error rate (about 20 per","x":36,"y":982,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":340,"h":24},{"id":"omvclgjli7n","type":"text","text":"10⁵ bases at Q ≥ 20 in both published studies),","x":36,"y":1004.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":370,"h":24},{"id":"omvclgjli7o","type":"text","text":"and how many of each animal's calls it explains","x":36,"y":1027,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":372,"h":24},{"id":"omvclgjli7p","type":"rect","x":480,"y":698,"w":440,"h":428,"rot":0,"fill":"#ffffff","stroke":"#b4bec8","strokeWidth":1.6,"radius":10},{"id":"omvclgjli7q","type":"text","text":"From both, and they agree","x":496,"y":710,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":261,"h":28},{"id":"omvclgjli7r","type":"text","text":"Wild type against AID-null","x":496,"y":750,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":217,"h":24},{"id":"omvclgjli7s","type":"text","text":"Sanger 38-fold; nanopore 141-fold, with controls","x":496,"y":773,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":378,"h":24},{"id":"omvclgjli7t","type":"text","text":"without calls counted at one event","x":496,"y":795.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":268,"h":24},{"id":"omvclgjli7u","type":"text","text":"Substitution spectrum","x":496,"y":832,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":183,"h":24},{"id":"omvclgjli7v","type":"text","text":"r = 0.92 (95% CI 0.74–0.98), slope 0.97","x":496,"y":855,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":311,"h":24},{"id":"omvclgjli7w","type":"text","text":"Position along the window","x":496,"y":891.5,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":219,"h":24},{"id":"omvclgjli7x","type":"text","text":"r = 0.94 in 25-bp bins","x":496,"y":914.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":169,"h":24},{"id":"omvclgjli7y","type":"text","text":"AID hotspot use","x":496,"y":951,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":136,"h":24},{"id":"omvclgjli7z","type":"text","text":"G:C at WRC/GYW 58% and 54% (20% of sites);","x":496,"y":974,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":379,"h":24},{"id":"omvclgjli80","type":"text","text":"A:T at WA/TW 70% and 69% (50% of sites)","x":496,"y":996.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":342,"h":24},{"id":"omvclgjli81","type":"text","text":"Not comparable: absolute density","x":496,"y":1033,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","bold":true,"w":280,"h":24},{"id":"omvclgjli82","type":"text","text":"a clone is read once; nanopore counts unique","x":496,"y":1056,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":359,"h":24},{"id":"omvclgjli83","type":"text","text":"mutations among 500 reads. Compare densities","x":496,"y":1078.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":377,"h":24},{"id":"omvclgjli84","type":"text","text":"within a platform, not between.","x":496,"y":1101,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":242,"h":24},{"id":"omvclgjli85","type":"rect","x":940,"y":698,"w":440,"h":428,"rot":0,"fill":"#eef5f8","stroke":"#b3d0db","strokeWidth":1.6,"radius":10},{"id":"omvclgjli86","type":"text","text":"From the nanopore reads here","x":956,"y":710,"rot":0,"fontSize":20.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":299,"h":28},{"id":"omvclgjli87","type":"text","text":"The whole amplicon","x":956,"y":750,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":169,"h":24},{"id":"omvclgjli88","type":"text","text":"positions 90–1,230: 229-fold over controls; 69%","x":956,"y":773,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":374,"h":24},{"id":"omvclgjli89","type":"text","text":"of mutations in the first 450 bp, falling 7-fold","x":956,"y":795.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":343,"h":24},{"id":"omvclgjli8a","type":"text","text":"to the last 250 bp (Figure 6A)","x":956,"y":818,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":231,"h":24},{"id":"omvclgjli8b","type":"text","text":"Clones and mutation trees","x":956,"y":854.5,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":221,"h":24},{"id":"omvclgjli8c","type":"text","text":"clones of each mouse, and their mutations","x":956,"y":877.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":333,"h":24},{"id":"omvclgjli8d","type":"text","text":"ordered into trees (Figures 6 and S11)","x":956,"y":900,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":301,"h":24},{"id":"omvclgjli8e","type":"text","text":"Calls at an estimated false-discovery rate","x":956,"y":936.5,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":344,"h":24},{"id":"omvclgjli8f","type":"text","text":"each candidate tested against the controls,","x":956,"y":959.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":337,"h":24},{"id":"omvclgjli8g","type":"text","text":"the threshold set by them as decoys; single-read","x":956,"y":982,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":381,"h":24},{"id":"omvclgjli8h","type":"text","text":"mutations not called, as one background-","x":956,"y":1004.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":325,"h":24},{"id":"omvclgjli8i","type":"text","text":"subtracted estimate","x":956,"y":1027,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":157,"h":24}],"alt":"Figure S12. What Sanger clones and nanopore reads can each measure, how Illumina read pairs are merged and analyzed, and what Sanger and nanopore measure alike in the same mice."}],"uploads":[],"assets":{},"plotStyle":{"family":"Arial","fontSize":7,"tickSize":6.6,"labelSize":7,"titleSize":7,"legendSize":6.6,"minScriptPt":6,"axisLineWidth":0.8,"lineWidth":1.4,"markerSize":4,"palette":["#274b7e","#7a4f9a","#1f6f8b","#a3621b","#9a3439","#4a5562"]},"plotPrelude":{"python":"# ruff: noqa: F821  (plt comes from the SciCanvas plot worker)\n# Shared by the CRM code plots: the figures' plot prelude (SciCanvas 2.1), run before every plot in the app and by\n# build.js. Plots render at their printed size, so sizes below are printed points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return d * d\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n"},"journal":{"id":"cell","widthMM":174,"commercial":false,"guide":false}}