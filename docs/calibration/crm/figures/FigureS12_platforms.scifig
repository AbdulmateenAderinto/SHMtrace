Size":17.5,"color":"#4a5562","family":"arial","align":"left","w":491,"h":24},{"id":"omvfrt4dl7h","type":"text","text":"minimum alignment ≤ 100 bp; then the same control test and FDR.","x":760,"y":590.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":520,"h":24},{"id":"omvfrt4dl7i","type":"text","text":"The Ldha and CH12F3 files carry a flat Q30 (SRA), so their error","x":760,"y":613,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":504,"h":24},{"id":"omvfrt4dl7j","type":"text","text":"model has a single quality level; the Ramos files keep binned ones.","x":760,"y":635.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":525,"h":24},{"id":"omvfrt4dl7k","type":"text","text":"PACBIO: ONE READ ACROSS A SWITCH JUNCTION","x":20,"y":702,"rot":0,"fontSize":22.5,"color":"#9a3439","family":"arial","align":"left","bold":true,"w":590,"h":31},{"id":"omvfrt4dl7l","type":"text","text":"the donor, the join and the acceptor on a single HiFi read","x":20,"y":732,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","italic":true,"w":445,"h":24},{"id":"omvfrt4dl7m","type":"rect","x":20,"y":762,"w":1360,"h":2.6,"rot":0,"fill":"#9a3439","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvfrt4dl7n","type":"rect","x":170,"y":806,"w":264,"h":16,"rot":0,"fill":"#9a3439","stroke":"none","strokeWidth":0,"radius":2},{"id":"omvfrt4dl7o","type":"rect","x":434,"y":806,"w":336.00000000000006,"h":16,"rot":0,"fill":"#e2c2c2","stroke":"none","strokeWidth":0,"radius":2},{"id":"omvfrt4dl7p","type":"rect","x":432.4,"y":799,"w":3.2,"h":30,"rot":0,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvfrt4dl7q","type":"text","text":"join","x":417.5,"y":776,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"center","bold":true,"w":33,"h":24},{"id":"omvfrt4dl7r","type":"text","text":"Sμ donor","x":264,"y":832,"rot":0,"fontSize":17.5,"color":"#9a3439","family":"arial","a