{"version":2,"pages":[{"id":"crm-figS13","name":"Figure S13","width":1400,"height":1600,"background":"#ffffff","objects":[{"id":"omvb5zmpe1","type":"text","text":"EACH STAGE, ITS RULE AND ITS EQUATION","x":20,"y":4,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":511,"h":31},{"id":"omvb5zmpe2","type":"text","text":"THE STAGE AT WORK","x":880,"y":4,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":258,"h":31},{"id":"omvb5zmpe3","type":"rect","x":20,"y":38,"w":830,"h":2.6,"rot":0,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvb5zmpe4","type":"rect","x":880,"y":38,"w":510,"h":2.6,"rot":0,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvb5zmpe5","type":"rect","x":20,"y":52,"w":830,"h":240,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvb5zmpe6","type":"ellipse","x":33,"y":67,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"1","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvb5zmpe7","type":"text","text":"Read preparation","x":82,"y":72,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":172,"h":28},{"id":"omvb5zmpe8","type":"text","text":"Every read is gated before it is used. A read longer than the amplicon, or one","x":82,"y":108,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":601,"h":24},{"id":"omvb5zmpe9","type":"text","text":"whose quality scores predict more than one error in a hundred bases, is dropped.","x":82,"y":131,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":634,"h":24},{"id":"omvb5zmpea","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":180,"w":198.4,"h":50.4,"rot":0,"name":"equation 1","nw":794},{"id":"omvb5zmpeb","type":"rect","x":20,"y":310,"w":830,"h":240,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvb5zmpec","type":"ellipse","x":33,"y":325,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"2","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvb5zmped","type":"text","text":"Competitive alignment","x":82,"y":330,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":219,"h":28},{"id":"omvb5zmpee","type":"text","text":"Each read is aligned to the target, its paralogue and any contaminant at once,","x":82,"y":366,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":606,"h":24},{"id":"omvb5zmpef","type":"text","text":"and goes to whichever it matches best. A paralogue can also be analysed as a","x":82,"y":389,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":613,"h":24},{"id":"omvb5zmpeg","type":"text","text":"target of its own.","x":82,"y":412,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":133,"h":24},{"id":"omvb5zmpeh","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":461,"w":217.1,"h":35.7,"rot":0,"name":"equation 2","nw":868},{"id":"omvb5zmpei","type":"rect","x":20,"y":568,"w":830,"h":240,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvb5zmpej","type":"ellipse","x":33,"y":583,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"3","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvb5zmpek","type":"text","text":"Background measured in the controls","x":82,"y":588,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":364,"h":28},{"id":"omvb5zmpel","type":"text","text":"The error rate is not taken from the quality scores. It is measured in the AID-null","x":82,"y":624,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":621,"h":24},{"id":"omvb5zmpem","type":"text","text":"libraries per position, substitution, strand and quality, then inflated by one","x":82,"y":647,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":570,"h":24},{"id":"omvb5zmpen","type":"text","text":"factor fitted by leaving each control out in turn.","x":82,"y":670,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":362,"h":24},{"id":"omvb5zmpeo","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":719,"w":250.1,"h":37.1,"rot":0,"name":"equation 3","nw":1000},{"id":"omvb5zmpep","type":"rect","x":20,"y":826,"w":830,"h":240,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvb5zmpeq","type":"ellipse","x":33,"y":841,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"4","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvb5zmper","type":"text","text":"One test per candidate","x":82,"y":846,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":224,"h":28},{"id":"omvb5zmpes","type":"text","text":"Supporting reads are ranked by quality and every depth of evidence is tested","x":82,"y":882,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":600,"h":24},{"id":"omvb5zmpet","type":"text","text":"against that measured rate; the best test is kept and corrected for having tried","x":82,"y":905,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":606,"h":24},{"id":"omvb5zmpeu","type":"text","text":"them all. A change carried by half the reads or more is germline, not a mutation.","x":82,"y":928,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":622,"h":24},{"id":"omvb5zmpev","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":977,"w":448,"h":36.7,"rot":0,"name":"equation 4","nw":1792},{"id":"omvb5zmpew","type":"rect","x":20,"y":1084,"w":830,"h":240,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvb5zmpex","type":"ellipse","x":33,"y":1099,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"5","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvb5zmpey","type":"text","text":"Threshold set by the controls themselves","x":82,"y":1104,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":399,"h":28},{"id":"omvb5zmpez","type":"text","text":"Each control is called against the other controls, giving decoy p-values. The","x":82,"y":1140,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":589,"h":24},{"id":"omvb5zmpe10","type":"text","text":"threshold is the largest at which the false calls the decoys predict are at most","x":82,"y":1163,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":600,"h":24},{"id":"omvb5zmpe11","type":"text","text":"5% of the calls kept.","x":82,"y":1186,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":161,"h":24},{"id":"omvb5zmpe12","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":1235,"w":541,"h":43.2,"rot":0,"name":"equation 5","nw":2164},{"id":"omvb5zmpf13","type":"rect","x":20,"y":1342,"w":830,"h":240,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvb5zmpf14","type":"ellipse","x":33,"y":1357,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"6","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvb5zmpf15","type":"text","text":"One number per animal","x":82,"y":1362,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":233,"h":28},{"id":"omvb5zmpf16","type":"text","text":"Calls are summarised per library and compared between groups on the log scale,","x":82,"y":1398,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":635,"h":24},{"id":"omvb5zmpf17","type":"text","text":"with one value per animal, so clones of one lineage cannot stand in for","x":82,"y":1421,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":550,"h":24},{"id":"omvb5zmpf18","type":"text","text":"independent mice.","x":82,"y":1444,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":147,"h":24},{"id":"omvb5zmpf19","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":1493,"w":480.3,"h":36.9,"rot":0,"name":"equation 6","nw":1921},{"id":"omvb5zmpf1a","type":"text","text":"A","x":880,"y":52,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":20,"h":31},{"id":"omvb5zmpf1b","type":"text","text":"The fate of every read","x":906,"y":54,"rot":0,"fontSize":19,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":202,"h":26,"locked":true},{"id":"omvb5zmpf1f","type":"rect","x":1112,"y":59,"w":12,"h":12,"rot":0,"fill":"#9aa5b1","stroke":"none","strokeWidth":0,"radius":0,"locked":true},{"id":"omvb5zmpf1g","type":"text","text":"gated","x":1128,"y":54,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":48,"h":24,"locked":true},{"id":"omvb5zmpf1h","type":"rect","x":1186,"y":59,"w":12,"h":12,"rot":0,"fill":"#d9952b","stroke":"none","strokeWidth":0,"radius":0,"locked":true},{"id":"omvb5zmpf1i","type":"text","text":"not the target","x":1202,"y":54,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":108,"h":24,"locked":true},{"id":"omvb5zmpf1j","type":"rect","x":1320,"y":59,"w":12,"h":12,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"radius":0,"locked":true},{"id":"omvb5zmpf1k","type":"text","text":"usable","x":1336,"y":54,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":56,"h":24,"locked":true},{"id":"omvb5zmpf1l","type":"path","x":970,"y":92,"w":1,"h":136,"w0":1,"h0":136,"rot":0,"nodes":[{"x":0,"y":0},{"x":0,"y":136}],"closed":false,"fill":"none","stroke":"#1d2733","strokeWidth":1.8,"cap":"butt","locked":true},{"id":"omvb5zmpf1m","type":"path","x"