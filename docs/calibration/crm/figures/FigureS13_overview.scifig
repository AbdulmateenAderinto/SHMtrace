,"radius":10},{"id":"omvclklfu7m","type":"text","text":"Group tests","x":1146,"y":498,"rot":0,"fontSize":20.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":117,"h":28},{"id":"omvclklfu7n","type":"text","text":"Welch t on log₁₀ density,","x":1146,"y":532,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":200,"h":24},{"id":"omvclklfu7o","type":"text","text":"one value per animal","x":1146,"y":554.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":167,"h":24},{"id":"omvclklfu7p","type":"rect","x":1160,"y":694,"w":190,"h":1.6,"rot":0,"fill":"#b4bec8","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvclklfu7q","type":"ellipse","x":1196.5,"y":650.5,"w":11,"h":11,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":1.6},{"id":"omvclklfu7r","type":"ellipse","x":1209.5,"y":656.5,"w":11,"h":11,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":1.6},{"id":"omvclklfu7s","type":"ellipse","x":1222.5,"y":662.5,"w":11,"h":11,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":1.6},{"id":"omvclklfu7t","type":"rect","x":1189,"y":660.8,"w":52,"h":2.4,"rot":0,"fill":"#274b7e","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvclklfu7u","type":"text","text":"case","x":1194.5,"y":698,"rot":0,"fontSize":17.5,"color":"#274b7e","family":"arial","align":"center","w":41,"h":24},{"id":"omvclklfu7v","type":"ellipse","x":1276.5,"y":672.5,"w":11,"h":11,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":1.6},{"id":"omvclklfu7w","type":"ellipse","x":1289.5,"y":676.5,"w":11,"h":11,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":1.6},{"id":"omvclklfu7x","type":"ellipse","x":1302.5,"y":680.5,"w":11,"h":11,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":1.6},{"id":"omvclklfu7y","type":"rect","x":1269,"y":680.8,"w":52,"h":2.4,"rot":0,"fill":"#9a3439","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvclklfu7z","type":"text","text":"control","x":1266.5,"y":698,"rot":0,"fontSize":17.5,"color":"#9a3439","family":"arial","align":"center","w":57,"h":24},{"id":"omvclklfu80","type":"connector","from":{"id":"omvclklft14","port":"e"},"to":{"id":"omvclklft2o","port":"w"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvclklfu81","type":"connector","from":{"id":"omvclklft1t","port":"s"},"to":{"id":"omvclklft28","port":"n"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvclklfu82","type":"connector","from":{"id":"omvclklft1t","port":"e"},"to":{"id":"omvclklft32","port":"w"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvclklfu83","type":"connector","from":{"id":"omvclklft32","port":"e"},"to":{"id":"omvclklft3y","port":"w"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvclklfu84","type":"connector","from":{"id":"omvclklft3y","port":"s"},"to":{"id":"omvclklft4f","port":"n"},"head":"arrow","tail":"none","style":"elbow","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvclklfu85","type":"connector","from":{"id":"omvclklft4f","port":"e"},"to":{"id":"omvclklft6c","port":"w"},"head":"arrow","tail":"none","style":"elbow","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvclklfu86","type":"connector","from":{"id":"omvclklft6c","port":"s"},"to":{"id":"omvclklfu7l","port":"n"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvclklfu87","type":"connector","from":{"id":"omvclklft2o","port":"e"},"to":{"id":"omvclklft5d","port":"w"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7}],"alt":"Figure S13. An overview of SHMtrace: libraries and a sample sheet, read preparation, the control-calibrated analysis and bookkeeping checks, per-animal profiles and group tests."}],"uploads":[],"assets":{},"plotStyle":{"family":"Arial","fontSize":7,"tickSize":6.6,"labelSize":7,"titleSize":7,"legendSize":6.6,"minScriptPt":6,"axisLineWidth":0.8,"lineWidth":1.4,"markerSize":4,"palette":["#274b7e","#7a4f9a","#1f6f8b","#a3621b","#9a3439","#4a5562"]},"plotPrelude":{"python":"# ruff: noqa: F821  (plt comes from the SciCanvas plot worker)\n# Shared by the CRM code plots: the figures' plot prelude (SciCanvas 2.1), run before every plot in the app and by\n# build.js. Plots render at their printed size, so sizes below are printed points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return d * d\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n"},"journal":{"id":"cell","widthMM":174,"commercial":false,"guide":false}}