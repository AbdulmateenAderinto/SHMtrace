"y":364,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":421,"h":24},{"id":"omvbrncea2w","type":"text","text":"p-values. The threshold is the largest at which the false","x":586,"y":386.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":431,"h":24},{"id":"omvbrncea2x","type":"text","text":"calls the decoys predict are at most 5% of the calls kept.","x":586,"y":409,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":440,"h":24},{"id":"omvbrncea2y","type":"text","text":"","x":586,"y":431.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":4,"h":24},{"id":"omvbrncea2z","type":"text","text":"Sanger: every substitution at Q ≥ 20 counts; the AID-null","x":586,"y":454,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":441,"h":24},{"id":"omvbrncea30","type":"text","text":"clones measure the error, and each animal is told how many","x":586,"y":476.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":472,"h":24},{"id":"omvbrncea31","type":"text","text":"of its calls that background explains.","x":586,"y":499,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":286,"h":24},{"id":"omvbrncea32","type":"rect","x":570,"y":556,"w":530,"h":174,"rot":0,"fill":"#ffffff","stroke":"#a3621b","strokeWidth":1.6,"radius":10},{"id":"omvbrncea33","type":"text","text":"Bookkeeping checks (reported, never applied)","x":586,"y":568,"rot":0,"fontSize":20.5,"color":"#a3621b","family":"arial","align":"left","bold":true,"w":448,"h":28},{"id":"omvbrncea34","type":"text","text":"Copied traces and duplicate clones, as groups; clones","x":586,"y":600,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":424,"h":24},{"id":"omvbrncea35","type":"text","text":"shared between animals beyond chance; mutated control","x":586,"y":622.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":448,"h":24},{"id":"omvbrncea36","type":"text","text":"clones; label mismatches; load outliers. A trace filed under","x":586,"y":645,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":456,"h":24},{"id":"omvbrncea37","type":"text","text":"two animals on purpose is kept under both; an accidental","x":586,"y":667.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":446,"h":24},{"id":"omvbrncea38","type":"text","text":"copy is counted once.","x":586,"y":690,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":174,"h":24},{"id":"omvbrncea39","type":"text","text":"RESULTS","x":1198,"y":6,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"center","bold":true,"w":114,"h":31},{"id":"omvbrncea3a","type":"text","text":"per animal, then per group","x":1150,"y":36,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"center","italic":true,"w":210,"h":24},{"id":"omvbrncea3b","type":"rect","x":1130,"y":66,"w":250,"h":2.6,"rot":0,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvbrncea3c","type":"rect","x":1130,"y":83.5,"w":250,"h":382,"rot":0,"fill":"#ffffff","stroke":"#b4bec8","strokeWidth":1.6,"radius":10},{"id":"omvbrncea3d","type":"text","text":"Mutation profiles","x":1146,"y":98,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":164,"h":28},{"id":"omvbrncea3e","type":"text","text":"unique-variant density","x":1146,"y":132,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":176,"h":24},{"id":"omvbrncea3f","type":"text","text":"mutation frequency","x":1146,"y":156,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":153,"h":24},{"id":"omvbrncea3g","type":"text","text":"12-type spectrum,","x":1146,"y":180,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":145,"h":24},{"id":"omvbrncea3h","type":"text","text":"corrected for base","x":1146,"y":204,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":146,"h":24},{"id":"omvbrncea3i","type":"text","text":"composition","x":1146,"y":228,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":98,"h":24},{"id":"omvbrncea3j","type":"text","text":"AID (WRC/GYW) and","x":1146,"y":252,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":173,"h":24},{"id":"omvbrncea3k","type":"text","text":"Polη (WA/TW) hotspots","x":1146,"y":276,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":187,"h":24},{"id":"omvbrncea3l","type":"text","text":"position along the","x":1146,"y":300,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":142,"h":24},{"id":"omvbrncea3m","type":"text","text":"amplicon","x":1146,"y":324,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":75,"h":24},{"id":"omvbrncea3n","type":"text","text":"indels, clones and","x":1146,"y":348,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":145,"h":24},{"id":"omvbrncea3o","type":"text","text":"mutation trees","x":1146,"y":372,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":115,"h":24},{"id":"omvbrncea3p","type":"text","text":"calls the background","x":1146,"y":396,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":165,"h":24},{"id":"omvbrncea3q","type":"text","text":"explains (Sanger)","x":1146,"y":420,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":142,"h":24},{"id":"omvbrncea3r","type":"rect","x":1130,"y":486,"w":250,"h":244,"rot":0,"fill":"#edf5f8","stroke":"#b3d0db","strokeWidth":1.6,"radius":10},{"id":"omvbrncea3s","type":"text","text":"Group tests","x":1146,"y":498,"rot":0,"fontSize":20.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":117,"h":28},{"id":"omvbrncea3t","type":"text","text":"Welch t on log₁₀ density,","x":1146,"y":532,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":200,"h":24},{"id":"omvbrncea3u","type":"text","text":"one value per animal, so","x":1146,"y":554.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":195,"h":24},{"id":"omvbrncea3v","type":"text","text":"clones of one lineage","x":1146,"y":577,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":170,"h":24},{"id":"omvbrncea3w","type":"text","text":"cannot stand in for","x":1146,"y":599.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":148,"h":24},{"id":"omvbrncea3x","type":"text","text":"independent mice.","x":1146,"y":622,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":147,"h":24},{"id":"omvbrncea3y","type":"rect","x":1160,"y":694,"w":190,"h":1.6,"rot":0,"fill":"#b4bec8","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvbrncea3z","type":"ellipse","x":1196.5,"y":650.5,"w":11,"h":11,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":1.6},{"id":"omvbrncea40","type":"ellipse","x":1209.5,"y":656.5,"w":11,"h":11,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":1.6},{"id":"omvbrncea41","type":"ellipse","x":1222.5,"y":662.5,"w":11,"h":11,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":1.6},{"id":"omvbrncea42","type":"rect","x":1189,"y":660.8,"w":52,"h":2.4,"rot":0,"fill":"#274b7e","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvbrncea43","type":"text","text":"case","x":1194.5,"y":698,"rot":0,"fontSize":17.5,"color":"#274b7e","family":"arial","align":"center","w":41,"h":24},{"id":"omvbrncea44","type":"ellipse","x":1276.5,"y":672.5,"w":11,"h":11,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":1.6},{"id":"omvbrncea45","type":"ellipse","x":1289.5,"y":676.5,"w":11,"h":11,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":1.6},{"id":"omvbrncea46","type":"ellipse","x":1302.5,"y":680.5,"w":11,"h":11,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":1.6},{"id":"omvbrncea47","type":"rect","x":1269,"y":680.8,"w":52,"h":2.4,"rot":0,"fill":"#9a3439","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvbrncea48","type":"text","text":"control","x":1266.5,"y":698,"rot":0,"fontSize":17.5,"color":"#9a3439","family":"arial","align":"center","w":57,"h":24},{"id":"omvbrncea49","type":"connector","from":{"id":"omvbrnce914","port":"e"},"to":{"id":"omvbrncea24","port":"w"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvbrncea4a","type":"connector","from":{"id":"omvbrnce91i","port":"s"},"to":{"id":"omvbrnce91q","port":"n"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvbrncea4b","type":"connector","from":{"id":"omvbrnce91i","port":"e"},"to":{"id":"omvbrncea2c","port":"w"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvbrncea4c","type":"connector","from":{"id":"omvbrncea2c","port":"e"},"to":{"id":"omvbrncea2k","port":"w"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvbrncea4d","type":"connector","from":{"id":"omvbrncea2k","port":"s"},"to":{"id":"omvbrncea2t","port":"n"},"head":"arrow","tail":"none","style":"elbow","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvbrncea4e","type":"connector","from":{"id":"omvbrncea2t","port":"e"},"to":{"id":"omvbrncea3c","port":"w"},"head":"arrow","tail":"none","style":"elbow","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvbrncea4f","type":"connector","from":{"id":"omvbrncea3c","port":"s"},"to":{"id":"omvbrncea3r","port":"n"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvbrncea4g","type":"connector","from":{"id":"omvbrncea24","port":"e"},"to":{"id":"omvbrncea32","port":"w"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7}],"alt":"Figure S13. An overview of SHMtrace: libraries and a sample sheet, read preparation, the control-calibrated analysis and bookkeeping checks, per-animal profiles and group tests."}],"uploads":[],"assets":{},"plotStyle":{"family":"Arial","fontSize":7,"tickSize":6.6,"labelSize":7,"titleSize":7,"legendSize":6.6,"minScriptPt":6,"axisLineWidth":0.8,"lineWidth":1.4,"markerSize":4,"palette":["#274b7e","#7a4f9a","#1f6f8b","#a3621b","#9a3439","#4a5562"]},"plotPrelude":{"python":"# ruff: noqa: F821  (plt comes from the SciCanvas plot worker)\n# Shared by the CRM code plots: the figures' plot prelude (SciCanvas 2.1), run before every plot in the app and by\n# build.js. Plots render at their printed size, so sizes below are printed points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return d * d\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n"},"journal":{"id":"cell","widthMM":174,"commercial":false,"guide":false}}