{"version":2,"pages":[{"id":"crm-figS13","name":"Figure S13","width":1400,"height":1480,"background":"#ffffff","objects":[{"id":"omvb6y1k81","type":"text","text":"How SHMtrace turns reads into calls","x":20,"y":2,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":390,"h":31},{"id":"omvb6y1k9k","type":"group","name":"subtitle","x":20,"y":28,"w":1007,"h":36,"w0":1007,"h0":36,"rot":0,"children":[{"id":"omvb6y1k82","type":"text","text":"Every rule the engine applies, and the same rule working on the J","x":0,"y":6,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","italic":false,"w":512,"h":24},{"id":"omvb6y1k85","type":"text","text":"H","x":508,"y":12,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","italic":false,"w":17,"h":24},{"id":"omvb6y1k88","type":"text","text":"4 libraries (3 wild-type and 3 ","x":521,"y":6,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","italic":false,"w":228,"h":24},{"id":"omvb6y1k8b","type":"text","text":"Aicda","x":745,"y":6,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","italic":true,"w":48,"h":24},{"id":"omvb6y1k8e","type":"text","text":"−/−","x":789,"y":0,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","italic":false,"w":30,"h":24},{"id":"omvb6y1k9h","type":"text","text":" mice, 500 reads each).","x":815,"y":6,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","italic":false,"w":192,"h":24}]},{"id":"omvb6y1k9l","type":"rect","x":20,"y":68,"w":1370,"h":2.6,"rot":0,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvb6y1k9m","type":"rect","x":20,"y":84,"w":830,"h":214,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvb6y1k9n","type":"ellipse","x":33,"y":99,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"1","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvb6y1k9o","type":"text","text":"Read preparation","x":82,"y":104,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":172,"h":28},{"id":"omvb6y1k9p","type":"text","text":"Every read is gated before it is used. A read longer than the amplicon, or one","x":82,"y":140,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":601,"h":24},{"id":"omvb6y1k9q","type":"text","text":"whose quality scores predict more than one error in a hundred bases, is dropped.","x":82,"y":163,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":634,"h":24},{"id":"omvb6y1k9r","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":206,"w":198.4,"h":50.4,"rot":0,"name":"equation 1","nw":794},{"id":"omvb6y1k9s","type":"rect","x":20,"y":316,"w":830,"h":214,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvb6y1k9t","type":"ellipse","x":33,"y":331,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"2","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvb6y1k9u","type":"text","text":"Competitive alignment","x":82,"y":336,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":219,"h":28},{"id":"omvb6y1k9v","type":"text","text":"Each read is aligned to the target, its paralogue and any contaminant at once,","x":82,"y":372,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":606,"h":24},{"id":"omvb6y1k9w","type":"text","text":"and goes to whichever it matches best. A paralogue can also be analysed as a","x":82,"y":395,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":613,"h":24},{"id":"omvb6y1k9x","type":"text","text":"target of its own.","x":82,"y":418,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":133,"h":24},{"id":"omvb6y1k9y","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":461,"w":217.1,"h":35.7,"rot":0,"name":"equation 2","nw":868},{"id":"omvb6y1k9z","type":"rect","x":20,"y":548,"w":830,"h":214,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvb6y1k910","type":"ellipse","x":33,"y":563,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"3","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvb6y1k911","type":"text","text":"Background measured in the controls","x":82,"y":568,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":364,"h":28},{"id":"omvb6y1k912","type":"text","text":"The error rate is not taken from the quality scores. It is measured in the AID-null","x":82,"y":604,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":621,"h":24},{"id":"omvb6y1k913","type":"text","text":"libraries per position, substitution, strand and quality, then inflated by one","x":82,"y":627,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":570,"h":24},{"id":"omvb6y1k914","type":"text","text":"factor fitted by leaving each control out in turn.","x":82,"y":650,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":362,"h":24},{"id":"omvb6y1k915","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":693,"w":250.1,"h":37.1,"rot":0,"name":"equation 3","nw":1000},{"id":"omvb6y1k916","type":"rect","x":20,"y":780,"w":830,"h":214,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvb6y1k917","type":"ellipse","x":33,"y":795,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"4","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvb6y1k918","type":"text","text":"One test per candidate","x":82,"y":800,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":224,"h":28},{"id":"omvb6y1k919","type":"text","text":"Supporting reads are ranked by quality and every depth of evidence is tested","x":82,"y":836,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":600,"h":24},{"id":"omvb6y1k91a","type":"text","text":"against that measured rate; the best test is kept and corrected for having tried","x":82,"y":859,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":606,"h":24},{"id":"omvb6y1k91b","type":"text","text":"them all. A change carried by half the reads or more is germline, not a mutation.","x":82,"y":882,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":622,"h":24},{"id":"omvb6y1k91c","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":925,"w":448,"h":36.7,"rot":0,"name":"equation 4","nw":1792},{"id":"omvb6y1k91d","type":"rect","x":20,"y":1012,"w":830,"h":214,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvb6y1k91e","type":"ellipse","x":33,"y":1027,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"5","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvb6y1k91f","type":"text","text":"Threshold set by the controls themselves","x":82,"y":1032,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":399,"h":28},{"id":"omvb6y1k91g","type":"text","text":"Each control is called against the other controls, giving decoy p-values. The","x":82,"y":1068,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":589,"h":24},{"id":"omvb6y1k91h","type":"text","text":"threshold is the largest at which the false calls the decoys predict are at most","x":82,"y":1091,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":600,"h":24},{"id":"omvb6y1k91i","type":"text","text":"5% of the calls kept.","x":82,"y":1114,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":161,"h":24},{"id":"omvb6y1k91j","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":1157,"w":541,"h":43.2,"rot":0,"name":"equation 5","nw":2164},{"id":"omvb6y1k91k","type":"rect","x":20,"y":1244,"w":830,"h":214,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvb6y1k91l","type":"ellipse","x":33,"y":1259,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"6","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvb6y1k91m","type":"text","text":"One number per animal","x":82,"y":1264,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":233,"h":28},{"id":"omvb6y1k91n","type":"text","text":"Calls are summarised per library and compared between groups on the log scale,","x":82,"y":1300,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":635,"h":24},{"id":"omvb6y1k91o","type":"text","text":"with one value per animal, so clones of one lineage cannot stand in for","x":82,"y":1323,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":550,"h":24},{"id":"omvb6y1k91p","type":"text","text":"independent mice.","x":82,"y":1346,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":147,"h":24},{"id":"omvb6y1k91q","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":1389,"w":480.3,"h":36.9,"rot":0,"name":"equation 6","nw":1921},{"id":"omvb6y1k91r","type":"text","text":"A","x":880,"y":84,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":20,"h":31},{"id":"omvb6y1k91s","type":"text","text":"The fate of every read","x":906,"y":86,"rot":0,"fontSize":19,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":202,"h":26,"locked":true},{"id":"omvb6y1k91w","type":"rect","x":1112,"y":91,"w":12,"h":12,"rot":0,"fill":"#9aa5b1","stroke":"none","strokeWidth":0,"radius":0,"locked":true},{"id":"omvb6y1k91x","type":"text","text":"gated","x":1128,"y":86,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w"