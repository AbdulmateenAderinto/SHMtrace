e":"none","strokeWidth":0,"radius":0.9},{"id":"omvbviahcae","type":"text","text":"2k","x":1030.5,"y":1457,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"center","w":23,"h":24},{"id":"omvbviahcaf","type":"rect","x":1115,"y":1450.1,"w":6,"h":1.8,"rot":90,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":0.9},{"id":"omvbviahcag","type":"text","text":"3k","x":1106.5,"y":1457,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"center","w":23,"h":24},{"id":"omvbviahcah","type":"rect","x":1191,"y":1450.1,"w":6,"h":1.8,"rot":90,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":0.9},{"id":"omvbviahcai","type":"text","text":"4k","x":1182.5,"y":1457,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"center","w":23,"h":24},{"id":"omvbviahcaj","type":"rect","x":1267,"y":1450.1,"w":6,"h":1.8,"rot":90,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":0.9},{"id":"omvbviahcak","type":"text","text":"5k","x":1258.5,"y":1457,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"center","w":23,"h":24},{"id":"omvbviahcal","type":"text","text":"delivered reads","x":1018,"y":1480,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"center","w":124,"h":24}],"alt":"Supplementary Figure S11. Workflow as run by SHMtrace from the delivered reads: experimental design, read preparation, variant calling, the Sanger route and the fate of every delivered read."}],"uploads":[],"assets":{},"plotStyle":{"family":"Arial","fontSize":7,"tickSize":6.6,"labelSize":7,"titleSize":7,"legendSize":6.6,"minScriptPt":6,"axisLineWidth":0.8,"lineWidth":1.4,"markerSize":4,"palette":["#274b7e","#7a4f9a","#1f6f8b","#a3621b","#9a3439","#4a5562"]},"plotPrelude":{"python":"# ruff: noqa: F821  (plt comes from the SciCanvas plot worker)\n# Shared by the CRM code plots: the figures' plot prelude (SciCanvas 2.1), run before every plot in the app and by\n# build.js. Plots render at their printed size, so sizes below are printed points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return d * d\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n"},"journal":{"id":"cell","widthMM":174,"commercial":false,"guide":false}}