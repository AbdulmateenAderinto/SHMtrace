"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":173,"h":24},{"id":"omvgzs53vav","type":"text","text":"284","x":1238,"y":732,"rot":0,"fontSize":17.5,"color":"#a3621b","family":"arial","align":"right","w":34,"h":24},{"id":"omvgzs53vaw","type":"text","text":"271","x":1366,"y":732,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"right","w":34,"h":24},{"id":"omvgzs53vax","type":"text","text":"Background explains, Wt","x":860,"y":764,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":198,"h":24},{"id":"omvgzs53vay","type":"text","text":"–","x":1258,"y":764,"rot":0,"fontSize":17.5,"color":"#a3621b","family":"arial","align":"right","w":14,"h":24},{"id":"omvgzs53vaz","type":"text","text":"1-2%","x":1355,"y":764,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"right","w":45,"h":24},{"id":"omvgzs53vb0","type":"text","text":"...  ","x":874,"y":796,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","italic":false,"w":39,"h":24},{"id":"omvgzs53vb3","type":"text","text":"Maea","x":909,"y":796,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","italic":true,"w":48,"h":24},{"id":"omvgzs53vb6","type":"text","text":"–","x":1258,"y":796,"rot":0,"fontSize":17.5,"color":"#a3621b","family":"arial","align":"right","w":14,"h":24},{"id":"omvgzs53vb7","type":"text","text":"7-8%","x":1355,"y":796,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"right","w":45,"h":24},{"id":"omvgzs53vb8","type":"text","text":"Lineages under 2+ mice","x":860,"y":828,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":192,"h":24},{"id":"omvgzs53vb9","type":"text","text":"–","x":1258,"y":828,"rot":0,"fontSize":17.5,"color":"#a3621b","family":"arial","align":"right","w":14,"h":24},{"id":"omvgzs53vba","type":"text","text":"14 (49 clones)","x":1285,"y":828,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"right","w":115,"h":24},{"id":"omvgzs53vbb","type":"text","text":"Analysis","x":860,"y":860,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":70,"h":24},{"id":"omvgzs53vbc","type":"text","text":"SHMTool","x":1195,"y":860,"rot":0,"fontSize":17.5,"color":"#a3621b","family":"arial","align":"right","w":77,"h":24},{"id":"omvgzs53vbd","type":"text","text":"16 s","x":1362,"y":860,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"right","w":38,"h":24}],"alt":"Figure S13. A published Sanger study re-analysed automatically: frequency per mouse, agreement by mouse, mutations per clone, G:C transitions and transversions, the pooled substitution spectrum, and the published comparisons recovered."}],"uploads":[],"assets":{},"plotStyle":{"family":"Arial","fontSize":7,"tickSize":6.6,"labelSize":7,"titleSize":7,"legendSize":6.6,"minScriptPt":6,"axisLineWidth":0.8,"lineWidth":1.4,"markerSize":4,"palette":["#274b7e","#7a4f9a","#1f6f8b","#a3621b","#9a3439","#4a5562"]},"plotPrelude":{"python":"# ruff: noqa: F821  (plt comes from the SciCanvas plot worker)\n# Shared by the CRM code plots: the figures' plot prelude (SciCanvas 2.1), run before every plot in the app and by\n# build.js. Plots render at their printed size, so sizes below are printed points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return d * d\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n"},"journal":{"id":"cell","widthMM":174,"commercial":false,"guide":false}}