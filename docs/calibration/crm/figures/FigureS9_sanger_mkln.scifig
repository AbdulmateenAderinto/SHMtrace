{"version":2,"pages":[{"id":"crm-figS9","name":"Figure S9","width":1400,"height":560,"background":"#ffffff","objects":[{"id":"omvbg6iwb2","type":"text","text":"A","x":4,"y":2,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":20,"h":31},{"id":"omvbg6iwb3","type":"text","text":"Frequency per mouse","x":38,"y":6,"rot":0,"fontSize":19.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":206,"h":27},{"id":"plot1","type":"icon","iconId":"upload:plot0","x":20,"y":40,"w":364,"h":452,"rot":0,"name":"A: frequency per mouse","plot":{"lang":"python","code":"# The page prints at 174 mm from 1,400 units, so lines and markers are drawn PAGE times their printed size.\nPAGE = 2.1288\nfor _k in (\"axes.linewidth\", \"xtick.major.width\", \"ytick.major.width\", \"xtick.minor.width\", \"ytick.minor.width\",\n           \"xtick.major.size\", \"ytick.major.size\", \"xtick.minor.size\", \"ytick.minor.size\", \"lines.linewidth\",\n           \"lines.markersize\", \"lines.markeredgewidth\", \"patch.linewidth\", \"grid.linewidth\", \"hatch.linewidth\",\n           \"errorbar.capsize\", \"xtick.major.pad\", \"ytick.major.pad\", \"axes.labelpad\"):\n    plt.rcParams[_k] = plt.rcParams[_k] * PAGE\nplt.rcParams[\"xtick.labelsize\"] = plt.rcParams[\"ytick.labelsize\"] = FONT_SIZE * 6.6 / 7\nplt.rcParams[\"legend.fontsize\"] = FONT_SIZE * 6.6 / 7\nplt.rcParams[\"axes.titlesize\"] = FONT_SIZE\n\n# ruff: noqa: F821  (plt, PAGE and FONT_SIZE come from the SciCanvas plot worker and build.js's preamble)\n# Shared by the CRM code plots (SciCanvas 2.0). Prepended to each plot's code by the builders, so every plot in a\n# .scifig re-runs on its own in SciCanvas. PAGE and the rcParams scaling come from build.js's preamble: sizes below\n# are the printed sizes, in points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return (d * PAGE) ** 2\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w * PAGE\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n\nD = json.loads(\"{\\\"A\\\":{\\\"WT\\\":{\\\"sh\\\":[87.64,137.81,81.92],\\\"pub\\\":[72.94,94.79,35.48]},\\\"Mkln1_KO\\\":{\\\"sh\\\":[18.9,8.54,10.88],\\\"pub\\\":[8.86,11.2,6.08]},\\\"Aicda_KO\\\":{\\\"sh\\\":[0,2.1,2.1],\\\"pub\\\":[]}},\\\"col\\\":{\\\"WT\\\":[\\\"#274b7e\\\",\\\"#6d9ad0\\\"],\\\"Mkln1_KO\\\":[\\\"#7a4f9a\\\",\\\"#bda3d4\\\"],\\\"Aicda_KO\\\":[\\\"#9a3439\\\",\\\"#d07a7e\\\"]}}\")\n\nfig, ax = plt.subplots()\nfor i, g in enumerate([\"WT\", \"Mkln1_KO\", \"Aicda_KO\"]):\n    e, f = D[\"col\"][g]\n    sh, pub = D[\"A\"][g][\"sh\"], D[\"A\"][g][\"pub\"]\n    strip(ax, i - 0.2, sh, f, e, d=5.0, spread=0.06); mean_bar(ax, i - 0.2, sh, SH, half=0.14)\n    if pub:\n        strip(ax, i + 0.2, pub, \"white\", e, d=4.6, spread=0.06, marker=\"s\"); mean_bar(ax, i + 0.2, pub, PUB, half=0.14)\nax.set_xticks(range(3), [\"Wt\", \"Mkln1\\n−/−\", \"Aicda\\n−/−\"])\nfor lab in ax.get_xticklabels()[1:]:\n    lab.set_fontstyle(\"italic\")\nax.set_xlim(-0.6, 2.6); ax.set_ylim(0, 160)\nax.set_ylabel(\"Mutations per 10⁴ bp\")\nax.scatter([], [], s=area(5.0), facecolor=\"#b9c2cc\", edgecolor=INK, linewidth=lw(0.6), label=\"SHMtrace\")\nax.scatter([], [], s=area(4.6), facecolor=\"white\", edgecolor=INK, linewidth=lw(0.6), marker=\"s\", label=\"Published\")\nax.legend(loc=\"upper right\", frameon=False, handletextpad=0.2, borderaxespad=0.1, labelspacing=0.3)\n","w":364,"h":452,"files":[],"error":null,"textEdits":{}}},{"id":"omvbg6jcp4","type":"text","text":"B","x":384,"y":2,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":20,"h":31},{"id":"omvbg6jcp5","type":"text","text":"G:C Ts and Tv","x":418,"y":6,"rot":0,"fontSize":19.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":139,"h":27},{"id":"plot2","type":"icon","iconId":"upload:plot1","x":400,"y":40,"w":300,"h":452,"rot":0,"name":"B: G:C Ts and Tv","plot":{"lang":"python","code":"# The page prints at 174 mm from 1,400 units, so lines and markers are drawn PAGE times their printed size.\nPAGE = 2.1288\nfor _k in (\"axes.linewidth\", \"xtick.major.width\", \"ytick.major.width\", \"xtick.minor.width\", \"ytick.minor.width\",\n           \"xtick.major.size\", \"ytick.major.size\", \"xtick.minor.size\", \"ytick.minor.size\", \"lines.linewidth\",\n           \"lines.markersize\", \"lines.markeredgewidth\", \"patch.linewidth\", \"grid.linewidth\", \"hatch.linewidth\",\n           \"errorbar.capsize\", \"xtick.major.pad\", \"ytick.major.pad\", \"axes.labelpad\"):\n    plt.rcParams[_k] = plt.rcParams[_k] * PAGE\nplt.rcParams[\"xtick.labelsize\"] = plt.rcParams[\"ytick.labelsize\"] = FONT_SIZE * 6.6 / 7\nplt.rcParams[\"legend.fontsize\"] = FONT_SIZE * 6.6 / 7\nplt.rcParams[\"axes.titlesize\"] = FONT_SIZE\n\n# ruff: noqa: F821  (plt, PAGE and FONT_SIZE come from the SciCanvas plot worker and build.js's preamble)\n# Shared by the CRM code plots (SciCanvas 2.0). Prepended to each plot's code by the builders, so every plot in a\n# .scifig re-runs on its own in SciCanvas. PAGE and the rcParams scaling come from build.js's preamble: sizes below\n# are the printed sizes, in points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return (d * PAGE) ** 2\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w * PAGE\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n\nD = json.loads(\"{\\\"B\\\":[{\\\"group\\\":\\\"WT\\\",\\\"kind\\\":\\\"Ts\\\",\\\"sh\\\":[20.26,19.03,26.92],\\\"pub\\\":[24.66,22.56,23.29]},{\\\"group\\\":\\\"WT\\\",\\\"kind\\\":\\\"Tv\\\",\\\"sh\\\":[19.61,15.04,11.54],\\\"pub\\\":[17.12,16.41,13.7]},{\\\"group\\\":\\\"Mkln1_KO\\\",\\\"kind\\\":\\\"Ts\\\",\\\"sh\\\":[33.33,16.67,21.43],\\\"pub\\\":[32.35,22.03,29.17]},{\\\"group\\\":\\\"Mkln1_KO\\\",\\\"kind\\\":\\\"Tv\\\",\\\"sh\\\":[29.63,26.19,30.95],\\\"pub\\\":[26.47,30.51,25]}],\\\"col\\\":{\\\"WT\\\":[\\\"#274b7e\\\",\\\"#6d9ad0\\\"],\\\"Mkln1_KO\\\":[\\\"#7a4f9a\\\",\\\"#bda3d4\\\"],\\\"Aicda_KO\\\":[\\\"#9a3439\\\",\\\"#d07a7e\\\"]}}\")\n\nfig, ax = plt.subplots()\nfor i, b in enumerate(D[\"B\"]):\n    e, f = D[\"col\"][b[\"group\"]]\n    strip(ax, i - 0.2, b[\"sh\"], f, e, d=4.6, spread=0.06); mean_bar(ax, i - 0.2, b[\"sh\"], SH, half=0.13)\n    strip(ax, i + 0.2, b[\"pub\"], \"white\", e, d=4.2, spread=0.06, marker=\"s\"); mean_bar(ax, i + 0.2, b[\"pub\"], PUB, half=0.13)\nax.set_xticks(range(4), [f\"{b['kind']}\\n{'Wt' if b['group'] == 'WT' else 'KO'}\" for b in D[\"B\"]])\nax.set_xlim(-0.6, 3.6); ax.set_ylim(0, 40); ax.set_yticks([0, 10, 20, 30, 40])\nax.set_ylabel(\"% of mutations at G:C\")\n","w":300,"h":452,"files":[],"error":null,"textEdits":{}}},{"id":"omvbg6jnc6","type":"text","text":"C","x":700,"y":2,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":22,"h":31},{"id":"omvbg6jnc7","type":"text","text":"Spectrum","x":734,"y":6,"rot":0,"fontSize":19.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":93,"h":27},{"id":"plot3","type":"icon","iconId":"upload:plot2","x":716,"y":40,"w":250,"h":452,"rot":0,"name":"C: substitution spectrum","plot":{"lang":"python","code":"# The page prints at 174 mm from 1,400 units, so lines and markers are drawn PAGE times their printed size.\nPAGE = 2.1288\nfor _k in (\"axes.linewidth\", \"xtick.major.width\", \"ytick.major.width\", \"xtick.minor.width\", \"ytick.minor.width\",\n           \"xtick.major.size\", \"ytick.major.size\", \"xtick.minor.size\", \"ytick.minor.size\", \"lines.linewidth\",\n           \"lines.markersize\", \"lines.markeredgewidth\", \"patch.linewidth\", \"grid.linewidth\", \"hatch.linewidth\",\n           \"errorbar.capsize\", \"xtick.major.pad\", \"ytick.major.pad\", \"axes.labelpad\"):\n    plt.rcParams[_k] = plt.rcParams[_k] * PAGE\nplt.rcParams[\"xtick.labelsize\"] = plt.rcParams[\"ytick.labelsize\"] = FONT_SIZE * 6.6 / 7\nplt.rcParams[\"legend.fontsize\"] = FONT_SIZE * 6.6 / 7\nplt.rcParams[\"axes.titlesize\"] = FONT_SIZE\n\n# ruff: noqa: F821  (plt, PAGE and FONT_SIZE come from the SciCanvas plot worker and build.js's preamble)\n# Shared by the CRM code plots (SciCanvas 2.0). Prepended to each plot's code by the builders, so every plot in a\n# .scifig re-runs on its own in SciCanvas. PAGE and the rcParams scaling come from build.js's preamble: sizes below\n# are the printed sizes, in points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return (d * PAGE) ** 2\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w * PAGE\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n\nD = json.loads(\"{\\\"C\\\":{\\\"WT\\\":[[10.386,11.387,\\\"A>T\\\"],[7.246,7.66,\\\"A>C\\\"],[16.184,15.735,\\\"A>G\\\"],[6.522,8.696,\\\"T>A\\\"],[13.285,14.493,\\\"T>C\\\"],[6.763,5.176,\\\"T>G\\\"],[2.415,2.277,\\\"C>A\\\"],[10.628,9.524,\\\"C>T\\\"],[2.899,2.899,\\\"C>G\\\"],[12.802,11.594,\\\"G>A\\\"],[5.072,4.348,\\\"G>T\\\"],[5.797,6.211,\\\"G>C\\\"]],\\\"Mkln1_KO\\\":[[9.402,6.306,\\\"A>T\\\"],[5.983,5.405,\\\"A>C\\\"],[11.111,17.117,\\\"A>G\\\"],[8.547,6.306,\\\"T>A\\\"],[6.838,9.91,\\\"T>C\\\"],[3.419,3.604,\\\"T>G\\\"],[5.983,6.306,\\\"C>A\\\"],[13.675,7.207,\\\"C>T\\\"],[6.838,4.505,\\\"C>G\\\"],[12.821,15.315,\\\"G>A\\\"],[7.692,9.009,\\\"G>T\\\"],[7.692,9.009,\\\"G>C\\\"]]},\\\"r\\\":0.82,\\\"col\\\":{\\\"WT\\\":[\\\"#274b7e\\\",\\\"#6d9ad0\\\"],\\\"Mkln1_KO\\\":[\\\"#7a4f9a\\\",\\\"#bda3d4\\\"],\\\"Aicda_KO\\\":[\\\"#9a3439\\\",\\\"#d07a7e\\\"]}}\")\n\nfig, ax = plt.subplots()\nax.plot([0, 20], [0, 20], color=SOFT, linewidth=lw(0.6), linestyle=(0, (3, 2)), zorder=1)\nfor g, lab in ((\"WT\", \"Wt\"), (\"Mkln1_KO\", \"Mkln1 −/−\")):\n    e, f = D[\"col\"][g]\n    ax.scatter([p[0] for p in D[\"C\"][g]], [p[1] for p in D[\"C\"][g]], s=area(4.6), facecolor=f, edgecolor=e,\n               linewidth=lw(0.6), zorder=3, label=lab)\nax.set_xlim(0, 20); ax.set_ylim(0, 20); ax.set_xticks([0, 10, 20]); ax.set_yticks([0, 10, 20])\nax.set_xlabel(\"Published (%)\"); ax.set_ylabel(\"SHMtrace (%)\")\nax.text(0.96, 0.04, f\"r = {D['r']:.2f}\", transform=ax.transAxes, ha=\"right\", va=\"bottom\", color=MID)\nleg = ax.legend(loc=\"upper left\", frameon=False, handletextpad=0.1, borderaxespad=0.1, labelspacing=0.2)\nleg.get_texts()[1].set_fontstyle(\"italic\")\n","w":250,"h":452,"files":[],"error":null,"textEdits":{}}},{"id":"omvbg6jy68","type":"text","text":"D","x":922,"y":2,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":22,"h":31},{"id":"omvbg6jy69","type":"text","text":"Published tests","x":956,"y":6,"rot":0,"fontSize":19.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":145,"h":27},{"id":"omvbg6jy6a","type":"text","text":"Published","x":1199,"y":90,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"right","bold":true,"w":86,"h":24},{"id":"omvbg6jy6b","type":"text","text":"SHMtrace","x":1313,"y":90,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"right","bold":true,"w":87,"h":24},{"id":"omvbg6jy6c","type":"path","x":990,"y":116,"w":410,"h":1,"w0":410,"h0":1,"rot":0,"nodes":[{"x":0,"y":0},{"x":410,"y":0}],"closed":false,"fill":"none","stroke":"#8a96a3","strokeWidth":1.6,"cap":"butt"},{"id":"omvbg6jy6d","type":"text","text":"Wt / ","x":990,"y":132,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","italic":false,"w":40,"h":24},{"id":"omvbg6jy6g","type":"text","text":"Mkln1","x":1026,"y":132,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","italic":true,"w":5