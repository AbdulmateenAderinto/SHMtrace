.6\"/>\n     <use xlink:href=\"#m6312fc195c\" x=\"57.629787\" y=\"23.720722\" style=\"fill: #bda3d4; stroke: #7a4f9a; stroke-width: 0.6\"/>\n     <use xlink:href=\"#m6312fc195c\" x=\"50.771615\" y=\"92.411603\" style=\"fill: #bda3d4; stroke: #7a4f9a; stroke-width: 0.6\"/>\n     <use xlink:href=\"#m6312fc195c\" x=\"46.200392\" y=\"69.512525\" style=\"fill: #bda3d4; stroke: #7a4f9a; stroke-width: 0.6\"/>\n     <use xlink:href=\"#m6312fc195c\" x=\"37.055271\" y=\"109.579558\" style=\"fill: #bda3d4; stroke: #7a4f9a; stroke-width: 0.6\"/>\n     <use xlink:href=\"#m6312fc195c\" x=\"43.913443\" y=\"92.411603\" style=\"fill: #bda3d4; stroke: #7a4f9a; stroke-width: 0.6\"/>\n     <use xlink:href=\"#m6312fc195c\" x=\"64.487959\" y=\"86.686834\" style=\"fill: #bda3d4; stroke: #7a4f9a; stroke-width: 0.6\"/>\n     <use xlink:href=\"#m6312fc195c\" x=\"46.200392\" y=\"103.854789\" style=\"fill: #bda3d4; stroke: #7a4f9a; stroke-width: 0.6\"/>\n     <use xlink:href=\"#m6312fc195c\" x=\"62.203685\" y=\"35.170261\" style=\"fill: #bda3d4; stroke: #7a4f9a; stroke-width: 0.6\"/>\n     <use xlink:href=\"#m6312fc195c\" x=\"48.484666\" y=\"75.237295\" style=\"fill: #bda3d4; stroke: #7a4f9a; stroke-width: 0.6\"/>\n     <use xlink:href=\"#m6312fc195c\" x=\"48.484666\" y=\"75.237295\" style=\"fill: #bda3d4; stroke: #7a4f9a; stroke-width: 0.6\"/>\n    </g>\n   </g>\n   <g id=\"text_9\">\n    <text style=\"font-size: 7px; font-family: 'Arial', 'Helvetica', 'DejaVu Sans', sans-serif; text-anchor: end; fill: #274b7e\" x=\"79.266196\" y=\"115.756383\" transform=\"rotate(-0 79.266196 115.756383)\">r = 0.97</text>\n   </g>\n   <g id=\"text_10\">\n    <text style=\"font-size: 7px; font-family: 'Arial', 'Helvetica', 'DejaVu Sans', sans-serif; text-anchor: end; fill: #7a4f9a\" x=\"79.266196\" y=\"127.193215\" transform=\"rotate(-0 79.266196 127.193215)\">r = 0.62ᶜ</text>\n   </g>\n   <g id=\"legend_1\">\n    <g id=\"PathCollection_3\">\n     <g>\n      <use xlink:href=\"#m5732ac2c9d\" x=\"37.81015\" y=\"11.775211\" style=\"fill: #6d9ad0; stroke: #274b7e; stroke-width: 0.6\"/>\n     </g>\n    </g>\n    <g id=\"text_11\">\n     <text style=\"font-size: 6.6px; font-family: 'Arial', 'Helvetica', 'DejaVu Sans', sans-serif; text-anchor: start; fill: #1d2733\" x=\"45.07015\" y=\"13.507711\" transform=\"rotate(-0 45.07015 13.507711)\">Wt</text>\n    </g>\n    <g id=\"PathCollection_4\">\n     <g>\n      <use xlink:href=\"#m6312fc195c\" x=\"37.81015\" y=\"19.289156\" style=\"fill: #bda3d4; stroke: #7a4f9a; stroke-width: 0.6\"/>\n     </g>\n    </g>\n    <g id=\"text_12\">\n     <text style=\"font-style: italic; font-size: 6.6px; font-family: 'Arial', 'Helvetica', 'DejaVu Sans', sans-serif; text-anchor: start; fill: #1d2733\" x=\"45.07015\" y=\"21.021656\" transform=\"rotate(-0 45.07015 21.021656)\">Mkln1 −/−</text>\n    </g>\n   </g>\n  </g>\n </g>\n <defs>\n  <clipPath id=\"p9057ac8d48\">\n   <rect x=\"27.91015\" y=\"5.40273\" width=\"53.495882\" height=\"127.075907\"/>\n  </clipPath>\n </defs>\n</svg>\n","name":"Python plot","pack":"codeplot","license":"own","author":"You"}},"plotStyle":{"family":"Arial","fontSize":7,"tickSize":6.6,"labelSize":7,"titleSize":7,"legendSize":6.6,"minScriptPt":6,"axisLineWidth":0.8,"lineWidth":1.4,"markerSize":4,"palette":["#274b7e","#7a4f9a","#1f6f8b","#a3621b","#9a3439","#4a5562"]},"plotPrelude":{"python":"# ruff: noqa: F821  (plt comes from the SciCanvas plot worker)\n# Shared by the CRM code plots: the figures' plot prelude (SciCanvas 2.1), run before every plot in the app and by\n# build.js. Plots render at their printed size, so sizes below are printed points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return d * d\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n"},"journal":{"id":"cell","widthMM":174,"commercial":false,"guide":false}}