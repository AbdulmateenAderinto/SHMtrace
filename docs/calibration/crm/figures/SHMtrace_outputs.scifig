")\n\nfig, ax = plt.subplots()\nx, y = D[\"bg\"][\"pos\"], D[\"bg\"][\"rate\"]\nax.fill_between(x, 5e-5, y, color=CTRLF, alpha=0.75, linewidth=0, step=\"mid\")\nmed = sorted(y)[len(y) // 2]\nax.axhline(med, color=INK, linestyle=(0, (3, 2)), linewidth=lw(0.7))\nax.text(x[-1] - 4, 1.8e-2, f\"median {100 * med:.2g}%\", ha=\"right\", va=\"center\", color=INK,\n        bbox=dict(facecolor=\"white\", edgecolor=\"none\", pad=1.0))\nax.set_yscale(\"log\"); ax.set_ylim(5e-5, 4e-2); ax.set_xlim(x[0], x[-1])\nax.yaxis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{100 * v:g}%\"))\nax.yaxis.set_minor_formatter(plt.NullFormatter())\nax.set_xlabel(\"Position in the amplicon (bp)\"); ax.set_ylabel(\"Control error rate\")\n","w":424,"h":240,"k":0.4697412823397076,"files":[],"error":null,"textEdits":{}}},{"id":"omvgwt9k84m","type":"text","text":"The error rate the AID-null controls showed at each","x":498,"y":608,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":401,"h":24},{"id":"omvgwt9k84n","type":"text","text":"position. A mutation is called only if it clears this","x":498,"y":629.5,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":374,"h":24},{"id":"omvgwt9k84o","type":"text","text":"floor, with predicted false calls held under 5%.","x":498,"y":651,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":360,"h":24},{"id":"omvgwt9k84x","type":"text","text":"Watch for:","x":498,"y":682.5,"rot":0,"fontSize":17.5,"color":"#9a3439","family":"arial","align":"left","bold":true,"w":89,"h":24},{"id":"omvgwt9k84y","type":"text","text":"spikes: calls there need much more","x":592,"y":682.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","leadColor":"#9a3439","w":280,"h":24},{"id":"omvgwt9k84z","type":"text","text":"support.","x":498,"y":704,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","leadColor":"#9a3439","w":68,"h":24},{"id":"omvgwt9k856","type":"text","text":"Also:","x":498,"y":737.5,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","bold":true,"w":46,"h":24},{"id":"omvgwt9k857","type":"text","text":"volcano · single_read_excess ·","x":549,"y":737.5,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","leadColor":"#6f7b88","w":244,"h":24},{"id":"omvgwt9k858","type":"text","text":"replicate_concordance","x":498,"y":759,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","leadColor":"#6f7b88","w":181,"h":24},{"id":"omvgwt9k859","type":"rect","x":940,"y":290,"w":440,"h":530,"rot":0,"fill":"#ffffff","stroke":"#1f6f8b","strokeWidth":1.6,"radius":10},{"id":"omvgwt9k85a","type":"rect","x":940,"y":290,"w":440,"h":6,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"radius":3},{"id":"omvgwt9k85b","type":"ellipse","x":955,"y":309,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0},{"id":"omvgwt9k85c","type":"text","text":"3","x":963.5,"y":315,"rot":0,"fontSize":20.5,"color":"#ffffff","family":"arial","align":"center","bold":true,"w":17,"h":28},{"id":"omvgwt9k85d","type":"text","text":"How much mutation?","x":998,"y":306,"rot":0,"fontSize":20.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":209,"h":28},{"id":"omvgwt9k85e","type":"text","text":"density_by_group","x":998,"y":331,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","italic":true,"w":143,"h":24},{"id":"plot3","type":"icon","iconId":"upload:plot2","x":948,"y":354,"w":424,"h":240,"rot":0,"name":"3: density_by_group","plot":{"lang":"python","code":"D = json.loads(\"{\\\"d\\\":{\\\"rows\\\":[[\\\"WT2\\\",\\\"Wt\\\",83.748,0.378952],[\\\"WT3\\\",\\\"Wt\\\",133.205,0.387223],[\\\"WT4\\\",\\\"Wt\\\",27.826,0.381177],[\\\"KO1\\\",\\\"Aicda-/-\\\",0,0.379331],[\\\"KO2\\\",\\\"Aicda-/-\\\",0.76,0.379856],[\\\"KO3\\\",\\\"Aicda-/-\\\",0,0.380227]],\\\"p\\\":0.002672,\\\"fold\\\":141.496427}}\")\n\nimport math\nfig, ax = plt.subplots()\nfor i, (g, e, f) in enumerate([(\"Wt\", CASE, CASEF), (\"Aicda-/-\", CTRL, CTRLF)]):\n    rows = [r for r in D[\"d\"][\"rows\"] if r[1] == g]\n    vals = [r[2] if r[2] > 0 else r[3] for r in rows]\n    xs = [i - 0.12 + 0.12 * k for k in range(len(rows))]\n    for xx, v, r in zip(xs, vals, rows):\n        ax.scatter([xx], [v], s=area(5.2), facecolor=f if r[2] > 0 else \"white\", edgecolor=e, linewidth=lw(0.8), zorder=3)\n    gm = math.exp(sum(math.log(v) for v in vals) / len(vals))\n    ax.plot([i - 0.24, i + 0.24], [gm, gm], color=e, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\nax.set_yscale(\"log\"); plain_log(ax.yaxis); ax.set_ylim(0.1, 2000)\nax.set_xticks([0, 1], [\"Wt\", \"Aicda−/−\"]); ax.get_xticklabels()[1].set_fontstyle(\"italic\")\nax.set_xlim(-0.6, 1.6)\ntop = 400\nax.plot([0, 0, 1, 1], [top / 1.5, top, top, top / 1.5], color=INK, linewidth=lw(0.7))\nax.text(0.5, top * 1.3, f\"P = {D['d']['p']:.4f},  {D['d']['fold']:.0f}×\", ha=\"center\", va=\"bottom\", color=INK)\nax.set_ylabel(\"Unique mutations\\nper 10$^{5}$ bp\")\n","w":424,"h":240,"k":0.4697412823397076,"files":[],"error":null,"textEdits":{}}},{"id":"omvgwt9yt61","type":"text","text":"One dot per animal (open: none found); bars are","x":958,"y":608,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":380,"h":24},{"id":"omvgwt9yt62","type":"text","text":"geometric means. The test counts each animal","x":958,"y":629.5,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":367,"h":24},{"id":"omvgwt9yt63","type":"text","text":"once, however many reads it gave.","x":958,"y":651,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":276,"h":24},{"id":"omvgwt9yt6i","type":"text","text":"Watch for:","x":958,"y":682.5,"rot":0,"fontSize":17.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":89,"h":24},{"id":"omvgwt9yt6j","type":"text","text":"frequency counts a clone's mutations in","x":1052,"y":682.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","leadColor":"#1f6f8b","w":310,"h":24},{"id":"omvgwt9yt6k","type":"text","text":"every read; unique density counts them once.","x":958,"y":704,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","leadColor":"#1f6f8b","w":358,"h":24},{"id":"omvgwt9yt6v","type":"text","text":"Also:","x":958,"y":737.5,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","bold":true,"w":46,"h":24},{"id":"omvgwt9yt6w","type":"text","text":"mutation_frequency_by_group ·","x":1009,"y":737.5,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","leadColor":"#6f7b88","w":251,"h":24},{"id":"omvgwt9yt6x","type":"text","text":"mutated_reads_by_group · mutation_load ·","x":958,"y":759,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","leadColor":"#6f7b88","w":338,"h":24},{"id":"omvgwt9yt6y","type":"text","text":"combined_density · indels","x":958,"y":780.5,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","leadColor":"#6f7b88","w":206,"h":24},{"id":"omvgwt9yt6z","type":"rect","x":20,"y":840,"w":440,"h":530,"rot":0,"fill":"#ffffff","stroke":"#6a4c93","strokeWidth":1.6,"radius":10},{"id":"omvgwt9yt70","type":"rect","x":20,"y":840,"w":440,"h":6,"rot":0,"fill":"#6a4c93","stroke":"none","strokeWidth":0,"radius":3},{"id":"omvgwt9yt71","type":"ellipse","x":35,"y":859,"w":34,"h":34,"rot":0,"fill":"#6a4c93","stroke":"none","strokeWidth":0},{"id":"omvgwt9yt72","type":"text","text":"4","x":43.5,"y":865,"rot":0,"fontSize":20.5,"color":"#ffffff","family":"arial","align":"center","bold":true,"w":17,"h":28},{"id":"omvgwt9yt73","type":"text","text":"What kind of mutation?","x":78,"y":856,"rot":0,"fontSize":20.5,"color":"#6a4c93","family":"arial","align":"left","bold":true,"w":227,"h":28},{"id":"omvgwt9yt74","type":"text","text":"spectrum_by_group","x":78,"y":881,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","ita