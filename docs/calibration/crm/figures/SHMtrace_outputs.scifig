"url(#pdce30b9966)\">\n     <use xlink:href=\"#m2f48a1d5c1\" x=\"81.839406\" y=\"54.708311\" style=\"fill: #6d9ad0; fill-opacity: 0.85; stroke: #274b7e; stroke-opacity: 0.85; stroke-width: 0.5\"/>\n    </g>\n   </g>\n   <g id=\"PathCollection_122\">\n    <g clip-path=\"url(#pdce30b9966)\">\n     <use xlink:href=\"#m2f48a1d5c1\" x=\"81.839406\" y=\"54.708311\" style=\"fill: #6d9ad0; fill-opacity: 0.85; stroke: #274b7e; stroke-opacity: 0.85; stroke-width: 0.5\"/>\n    </g>\n   </g>\n   <g id=\"PathCollection_123\">\n    <g clip-path=\"url(#pdce30b9966)\">\n     <use xlink:href=\"#m2f48a1d5c1\" x=\"81.839406\" y=\"54.708311\" style=\"fill: #6d9ad0; fill-opacity: 0.85; stroke: #274b7e; stroke-opacity: 0.85; stroke-width: 0.5\"/>\n    </g>\n   </g>\n   <g id=\"PathCollection_124\">\n    <g clip-path=\"url(#pdce30b9966)\">\n     <use xlink:href=\"#m2f48a1d5c1\" x=\"81.098093\" y=\"54.708311\" style=\"fill: #6d9ad0; fill-opacity: 0.85; stroke: #274b7e; stroke-opacity: 0.85; stroke-width: 0.5\"/>\n    </g>\n   </g>\n   <g id=\"PathCollection_125\">\n    <g clip-path=\"url(#pdce30b9966)\">\n     <use xlink:href=\"#m2f48a1d5c1\" x=\"81.098093\" y=\"52.243032\" style=\"fill: #6d9ad0; fill-opacity: 0.85; stroke: #274b7e; stroke-opacity: 0.85; stroke-width: 0.5\"/>\n    </g>\n   </g>\n   <g id=\"PathCollection_126\">\n    <g clip-path=\"url(#pdce30b9966)\">\n     <use xlink:href=\"#m2f48a1d5c1\" x=\"79.483175\" y=\"32.5208\" style=\"fill: #6d9ad0; fill-opacity: 0.85; stroke: #274b7e; stroke-opacity: 0.85; stroke-width: 0.5\"/>\n    </g>\n   </g>\n   <g id=\"PathCollection_127\">\n    <g clip-path=\"url(#pdce30b9966)\">\n     <use xlink:href=\"#m2f48a1d5c1\" x=\"77.652332\" y=\"54.708311\" style=\"fill: #6d9ad0; fill-opacity: 0.85; stroke: #274b7e; stroke-opacity: 0.85; stroke-width: 0.5\"/>\n    </g>\n   </g>\n   <g id=\"PathCollection_128\">\n    <g clip-path=\"url(#pdce30b9966)\">\n     <use xlink:href=\"#m2f48a1d5c1\" x=\"76.636241\" y=\"54.708311\" style=\"fill: #6d9ad0; fill-opacity: 0.85; stroke: #274b7e; stroke-opacity: 0.85; stroke-width: 0.5\"/>\n    </g>\n   </g>\n   <g id=\"PathCollection_129\">\n    <g clip-path=\"url(#pdce30b9966)\">\n     <use xlink:href=\"#m2f48a1d5c1\" x=\"76.636241\" y=\"52.243032\" style=\"fill: #6d9ad0; fill-opacity: 0.85; stroke: #274b7e; stroke-opacity: 0.85; stroke-width: 0.5\"/>\n    </g>\n   </g>\n   <g id=\"PathCollection_130\">\n    <g clip-path=\"url(#pdce30b9966)\">\n     <use xlink:href=\"#m2f48a1d5c1\" x=\"76.636241\" y=\"52.243032\" style=\"fill: #6d9ad0; fill-opacity: 0.85; stroke: #274b7e; stroke-opacity: 0.85; stroke-width: 0.5\"/>\n    </g>\n   </g>\n   <g id=\"PathCollection_131\">\n    <g clip-path=\"url(#pdce30b9966)\">\n     <use xlink:href=\"#m2f48a1d5c1\" x=\"74.34577\" y=\"54.708311\" style=\"fill: #6d9ad0; fill-opacity: 0.85; stroke: #274b7e; stroke-opacity: 0.85; stroke-width: 0.5\"/>\n    </g>\n   </g>\n   <g id=\"PathCollection_132\">\n    <g clip-path=\"url(#pdce30b9966)\">\n     <use xlink:href=\"#m2f48a1d5c1\" x=\"66.03507\" y=\"52.243032\" style=\"fill: #6d9ad0; fill-opacity: 0.85; stroke: #274b7e; stroke-opacity: 0.85; stroke-width: 0.5\"/>\n    </g>\n   </g>\n   <g id=\"patch_5\">\n    <path d=\"M 120.685467 47.615144 \nQ 120.685467 49.668224 120.685467 51.721304 \n\" style=\"fill: none; stroke: #274b7e; stroke-width: 0.6; stroke-linecap: round\"/>\n   </g>\n   <g id=\"text_9\">\n    <text style=\"font-size: 7px; font-family: 'Arial', 'Helvetica', 'DejaVu Sans', sans-serif; fill: #274b7e\" transform=\"translate(94.814998 33.9981)\">WT2: 323 reads,</text>\n    <text style=\"font-size: 7px; font-family: 'Arial', 'Helvetica', 'DejaVu Sans', sans-serif; fill: #274b7e\" transform=\"translate(104.14742 41.616752)\">unmutated</text>\n   </g>\n  </g>\n </g>\n <defs>\n  <clipPath id=\"pdce30b9966\">\n   <rect x=\"36.577982\" y=\"5.40273\" width=\"92.598368\" height=\"52.387179\"/>\n  </clipPath>\n </defs>\n</svg>\n","name":"Python plot","pack":"codeplot","license":"own","author":"You"}},"plotStyle":{"family":"Arial","fontSize":7,"tickSize":6.6,"labelSize":7,"titleSize":7,"legendSize":6.6,"minScriptPt":6,"axisLineWidth":0.8,"lineWidth":1.4,"markerSize":4,"palette":["#274b7e","#7a4f9a","#1f6f8b","#a3621b","#9a3439","#4a5562"]},"plotPrelude":{"python":"# ruff: noqa: F821  (plt comes from the SciCanvas plot worker)\n# Shared by the CRM code plots: the figures' plot prelude (SciCanvas 2.1), run before every plot in the app and by\n# build.js. Plots render at their printed size, so sizes below are printed points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return d * d\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n"},"journal":{"id":"cell","widthMM":174,"commercial":false,"guide":false}}