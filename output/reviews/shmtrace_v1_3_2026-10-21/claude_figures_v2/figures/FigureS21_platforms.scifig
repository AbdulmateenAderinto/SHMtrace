62","family":"arial","align":"left","w":58,"h":24},{"id":"omvj4n05h6s","type":"text","text":"Illumina, Ramos VDJ","x":20,"y":868,"rot":0,"fontSize":17.5,"color":"#3d5a80","family":"arial","align":"left","w":168,"h":24},{"id":"omvj4n05h6v","type":"rect","x":250,"y":872,"w":294.7,"h":14,"rot":0,"fill":"#3d5a80","stroke":"none","strokeWidth":0,"radius":2},{"id":"omvj4n05h6w","type":"text","text":"421 bp","x":552.7,"y":868,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":58,"h":24},{"id":"omvj4n05h6x","type":"text","text":"Illumina, CH12F3 VDJ","x":20,"y":894,"rot":0,"fontSize":17.5,"color":"#3d5a80","family":"arial","align":"left","w":178,"h":24},{"id":"omvj4n05h70","type":"rect","x":250,"y":898,"w":160.29999999999998,"h":14,"rot":0,"fill":"#3d5a80","stroke":"none","strokeWidth":0,"radius":2},{"id":"omvj4n05h71","type":"text","text":"229 bp","x":418.29999999999995,"y":894,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":58,"h":24},{"id":"omvj4n05h72","type":"text","text":"Illumina, ","x":20,"y":920,"rot":0,"fontSize":17.5,"color":"#3d5a80","family":"arial","align":"left","w":75,"h":24},{"id":"omvj4n05h75","type":"text","text":"J","x":91,"y":920,"rot":0,"fontSize":17.5,"color":"#3d5a80","family":"arial","align":"left","w":13,"h":24},{"id":"omvj4n05h78","type":"text","text":"H","x":100,"y":926,"rot":0,"fontSize":17.5,"color":"#3d5a80","family":"arial","align":"left","w":17,"h":24},{"id":"omvj4n05h7b","type":"text","text":"4 (Ldha)","x":113,"y":920,"rot":0,"fontSize":17.5,"color":"#3d5a80","family":"arial","align":"left","w":70,"h":24},{"id":"omvj4n05h7e","type":"rect","x":250,"y":924,"w":49,"h":14,"rot":0,"fill":"#3d5a80","stroke":"none","strokeWidth":0,"radius":2},{"id":"omvj4n05h7f","type":"text","text":"70 bp","x":307,"y":920,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":48,"h":24},{"id":"omvj4n05h7g","type":"text","text":"Illumina settings: minimap2 sr preset; error gate 0.02 per base; minimum alignment ≤ 100 bp; then the same control test and FDR.","x":20,"y":696,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":1011,"h":24},{"id":"omvj4n05h7h","type":"text","text":"The Ldha and CH12F3 files carry a flat Q30 (SRA), so their error model has one quality level; the Ramos files keep binned ones.","x":20,"y":718.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":999,"h":24},{"id":"omvj4n05h7i","type":"text","text":"PACBIO: ONE READ ACROSS A SWITCH JUNCTION","x":760,"y":300,"rot":0,"fontSize":22.5,"color":"#9a3439","family":"arial","align":"left","bold":true,"w":590,"h":31},{"id":"omvj4n05h7j","type":"text","text":"the donor, the join and the acceptor on a single read","x":760,"y":330,"rot":0,"fontSize":17.5,"color":"#6f7b88","family":"arial","align":"left","italic":true,"w":409,"h":24},{"id":"omvj4n05h7k","type":"rect","x":760,"y":360,"w":620,"h":2.6,"rot":0,"fill":"#9a3439","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvj4n05h7l","type":"rect","x":790,"y":424,"w":184.8,"h":16,"rot":0,"fill":"#9a3439","stroke":"none","strokeWidth":0,"radius":2},{"id":"omvj4n05h7m","type":"rect","x":974.8,"y":424,"w":235.20000000000002,"h":16,"rot":0,"fill":"#e2c2c2","stroke":"none","strokeWidth":0,"radius":2},{"id":"omvj4n05h7n","type":"rect","x":973.1999999999999,"y":417,"w":3.2,"h":30,"rot":0,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvj4n05h7o","type":"text","text":"join","x":958.3,"y":392,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"center","bold":true,"w":33,"h":24},{"id":"omvj4n05h7p","type":"text","text":"Sμ donor","x":844.4,"y":450,"rot":0,"fontSize":17.5,"color":"#9a3439","family":"arial","align":"center","w":76,"h":24},{"id":"omvj4n05h7q","type":"text","text":"Sγ1 acceptor","x":1038.3999999999999,"y":450,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"center","w":108,"h":24},{"id":"omvj4n05h7r","type":"text","text":"6,126 bp median","x":1224,"y":420,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":135,"h":24},{"id":"omvj4n05h7s","type":"text","text":"the join, its microhomology and any inserted bases are read, not inferred;","x":760,"y":488,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":571,"h":24},{"id":"omvj4n05h7t","type":"text","text":"reads per unique junction run 1.1–23.3, so counts track PCR recovery,","x":760,"y":510.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":550,"h":24},{"id":"omvj4n05h7u","type":"text","text":"not switching efficiency","x":760,"y":533,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":183,"h":24},{"id":"omvj4n05h7v","type":"text","text":"Microhomology at the join","x":760,"y":576,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":216,"h":24},{"id":"omvj4n05h7w","type":"text","text":"blunt","x":760,"y":601,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":42,"h":24},{"id":"omvj4n05h7z","type":"rect","x":892,"y":604,"w":21.6,"h":12,"rot":0,"fill":"#9a3439","stroke":"none","strokeWidth":0,"radius":2},{"id":"omvj4n05h80","type":"text","text":"14.4%","x":919.6,"y":601,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":54,"h":24},{"id":"omvj4n05h81","type":"text","text":"1–3 nt","x":760,"y":623,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":53,"h":24},{"id":"omvj4n05h84","type":"rect","x":892,"y":626,"w":57.15,"h":12,"rot":0,"fill":"#9a3439","stroke":"none","strokeWidth":0,"radius":2},{"id":"omvj4n05h85","type":"text","text":"38.1%","x":955.15,"y":623,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":54,"h":24},{"id":"omvj4n05h86","type":"text","text":"≥ 4 nt","x":760,"y":645,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":48,"h":24},{"id":"omvj4n05h89","typ