th":0,"radius":0},{"id":"omvj4n05h8o","type":"text","text":"Span","x":24,"y":1031,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","bold":true,"w":48,"h":24},{"id":"omvj4n05h8p","type":"text","text":"the 529-bp window the clones read cleanly","x":250,"y":1031,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":335,"h":24},{"id":"omvj4n05h8q","type":"text","text":"1,141 bp, positions 90–1,230","x":820,"y":1031,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":229,"h":24},{"id":"omvj4n05h8r","type":"rect","x":20,"y":1058,"w":1360,"h":1.2,"rot":0,"fill":"#cfd8df","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvj4n05h8s","type":"text","text":"Calling rule","x":24,"y":1064,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","bold":true,"w":97,"h":24},{"id":"omvj4n05h8t","type":"text","text":"every change at Q ≥ 20 counted; the AID-null error","x":250,"y":1064,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":396,"h":24},{"id":"omvj4n05h8u","type":"text","text":"rate reported beside it, never subtracted","x":250,"y":1087,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":315,"h":24},{"id":"omvj4n05h8v","type":"text","text":"each candidate tested against the controls;","x":820,"y":1064,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":337,"h":24},{"id":"omvj4n05h8w","type":"text","text":"threshold from held-out controls as decoys","x":820,"y":1087,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":334,"h":24},{"id":"omvj4n05h8x","type":"rect","x":20,"y":1114,"w":1360,"h":1.2,"rot":0,"fill":"#cfd8df","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvj4n05h8y","type":"text","text":"Only here","x":24,"y":1120,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","bold":true,"w":85,"h":24},{"id":"omvj4n05h8z","type":"text","text":"per-clone mutation load; bookkeeping checks","x":250,"y":1120,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":356,"h":24},{"id":"omvj4n05h90","type":"text","text":"on the sample sheet (STAR Methods)","x":250,"y":1143,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":297,"h":24},{"id":"omvj4n05h91","type":"text","text":"whole-amplicon profile (Figure 6A); clones and","x":820,"y":1120,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":365,"h":24},{"id":"omvj4n05h92","type":"text","text":"read-level mutation trees (Figures 6, S17)","x":820,"y":1143,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":327,"h":24},{"id":"omvj4n05h93","type":"rect","x":20,"y":1170,"w":1360,"h":1.2,"rot":0,"fill":"#cfd8df","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvj4n05h94","type":"text","text":"Wt / AID-null","x":24,"y":1176,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","bold":true,"w":109,"h":24},{"id":"omvj4n05h95","type":"text","text":"38-fold","x":250,"y":1176,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":58,"h":24},{"id":"omvj4n05h96","type":"text","text":"141-fold (zero-call controls at one event)","x":820,"y":1176,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":318,"h":24},{"id":"omvj4n05h97","type":"rect","x":20,"y":1203,"w":1360,"h":1.2,"rot":0,"fill":"#cfd8df","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvj4n05h98","type":"text","text":"Limits","x":24,"y":1209,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","bold":true,"w":53,"h":24},{"id":"omvj4n05h99","type":"text","text":"26–40 clones per mouse; error about 20 per","x":250,"y":1209,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":346,"h":24},{"id":"omvj4n05h9a","type":"text","text":"10⁵ bases at Q ≥ 20 (published AID-null clones)","x":250,"y":1232,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":376,"h":24},{"id":"omvj4n05h9b","type":"text","text":"single-read mutations estimated only in aggregate;","x":820,"y":1209,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":396,"h":24},{"id":"omvj4n05h9c","type":"text","text":"no UMIs, so PCR duplicates are not collapsed","x":820,"y":1232,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":361,"h":24},{"id":"omvj4n05h9d","type":"rect","x":20,"y":1259,"w":1360,"h":1.2,"rot":0,"fill":"#cfd8df","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvj4n05h9e","type":"text","text":"Agreement in","x":24,"y":1265,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":115,"h":24},{"id":"omvj4n05h9f","type":"text","text":"the same six mice","x":24,"y":1288,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":153,"h":24},{"id":"omvj4n05h9g","type":"text","text":"spectrum r = 0.92 (pooled categories), slope 0.97; position r = 0.94 (25-bp bins);","x":250,"y":1265,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":624,"h":24},{"id":"omvj4n05h9h","type":"text","text":"G:C at WRC/GYW 58% and 54% (20% of sites), A:T at WA/TW 70% and 69% (50% of sites).","x":250,"y":1288,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":726,"h":24},{"id":"omvj4n05h9i","type":"text","text":"Absolute densities count different things and are compared within a platform, not between.","x":250,"y":1311,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","w":703,"h":24}],"alt":"Figure S21. What Sanger clones and nanopore reads can each measure, how Illumina read pairs are merged and analyzed, and what Sanger and nanopore measure alike in the same mice."}],"uploads":[],"assets":{},"plotStyle":{"family":"Arial","fontSize":7,"tickSize":6.6,"labelSize":7,"titleSize":7,"legendSize":6.6,"minScriptPt":6,"axisLineWidth":0.8,"lineWidth":1.4,"markerSize":4,"palette":["#274b7e","#7a4f9a","#1f6f8b","#a3621b","#9a3439","#4a5562"]},"plotPrelude":{"python":"# ruff: noqa: F821  (plt comes from the SciCanvas plot worker)\n# Shared by the CRM code plots: the figures' plot prelude (SciCanvas 2.1), run before every plot in the app and by\n# build.js. Plots render at their printed size, so sizes below are printed points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return d * d\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n"},"journal":{"id":"cell","widthMM":174,"commercial":false,"guide":false}}