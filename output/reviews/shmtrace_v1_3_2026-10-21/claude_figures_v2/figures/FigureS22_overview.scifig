":0,"radius":0},{"id":"omvlavrkg7m","type":"text","text":"indels","x":1289.5,"y":426,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"center","w":50,"h":24},{"id":"omvlavrkg7n","type":"rect","x":1130,"y":486,"w":250,"h":244,"rot":0,"fill":"#edf5f8","stroke":"#b3d0db","strokeWidth":1.6,"radius":10},{"id":"omvlavrkg7o","type":"text","text":"Group tests","x":1146,"y":498,"rot":0,"fontSize":20.5,"color":"#1f6f8b","family":"arial","align":"left","bold":true,"w":117,"h":28},{"id":"omvlavrkg7p","type":"text","text":"Welch t on log₁₀ density,","x":1146,"y":532,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":200,"h":24},{"id":"omvlavrkg7q","type":"text","text":"one value per animal","x":1146,"y":554.5,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":167,"h":24},{"id":"omvlavrkg7r","type":"rect","x":1160,"y":694,"w":190,"h":1.6,"rot":0,"fill":"#b4bec8","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvlavrkg7s","type":"ellipse","x":1196.5,"y":650.5,"w":11,"h":11,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":1.6},{"id":"omvlavrkg7t","type":"ellipse","x":1209.5,"y":656.5,"w":11,"h":11,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":1.6},{"id":"omvlavrkg7u","type":"ellipse","x":1222.5,"y":662.5,"w":11,"h":11,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":1.6},{"id":"omvlavrkg7v","type":"rect","x":1189,"y":660.8,"w":52,"h":2.4,"rot":0,"fill":"#274b7e","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvlavrkg7w","type":"text","text":"case","x":1194.5,"y":698,"rot":0,"fontSize":17.5,"color":"#274b7e","family":"arial","align":"center","w":41,"h":24},{"id":"omvlavrkg7x","type":"ellipse","x":1276.5,"y":672.5,"w":11,"h":11,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":1.6},{"id":"omvlavrkg7y","type":"ellipse","x":1289.5,"y":676.5,"w":11,"h":11,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":1.6},{"id":"omvlavrkg7z","type":"ellipse","x":1302.5,"y":680.5,"w":11,"h":11,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":1.6},{"id":"omvlavrkg80","type":"rect","x":1269,"y":680.8,"w":52,"h":2.4,"rot":0,"fill":"#9a3439","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvlavrkg81","type":"text","text":"control","x":1266.5,"y":698,"rot":0,"fontSize":17.5,"color":"#9a3439","family":"arial","align":"center","w":57,"h":24},{"id":"omvlavrkg82","type":"connector","from":{"id":"omvlavrkf16","port":"e"},"to":{"id":"omvlavrkg2q","port":"w"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvlavrkg83","type":"connector","from":{"id":"omvlavrkf1v","port":"s"},"to":{"id":"omvlavrkf2a","port":"n"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvlavrkg84","type":"connector","from":{"id":"omvlavrkf1v","port":"e"},"to":{"id":"omvlavrkg34","port":"w"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvlavrkg85","type":"connector","from":{"id":"omvlavrkg34","port":"e"},"to":{"id":"omvlavrkg40","port":"w"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvlavrkg86","type":"connector","from":{"id":"omvlavrkg40","port":"s"},"to":{"id":"omvlavrkg4h","port":"n"},"head":"arrow","tail":"none","style":"elbow","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvlavrkg87","type":"connector","from":{"id":"omvlavrkg4h","port":"e"},"to":{"id":"omvlavrkg6e","port":"w"},"head":"arrow","tail":"none","style":"elbow","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvlavrkg88","type":"connector","from":{"id":"omvlavrkg6e","port":"s"},"to":{"id":"omvlavrkg7n","port":"n"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7},{"id":"omvlavrkg89","type":"connector","from":{"id":"omvlavrkg2q","port":"e"},"to":{"id":"omvlavrkg5f","port":"w"},"head":"arrow","tail":"none","style":"straight","curve":40,"color":"#4a5562","width":2.2,"headSize":0.7}],"alt":"Figure S23. An overview of SHMtrace: libraries and a sample sheet, read preparation, the control-calibrated analysis and bookkeeping checks, per-animal profiles and group tests."}],"uploads":[],"assets":{},"plotStyle":{"family":"Arial","fontSize":7,"tickSize":6.6,"labelSize":7,"titleSize":7,"legendSize":6.6,"minScriptPt":6,"axisLineWidth":0.8,"lineWidth":1.4,"markerSize":4,"palette":["#274b7e","#7a4f9a","#1f6f8b","#a3621b","#9a3439","#4a5562"]},"plotPrelude":{"python":"# ruff: noqa: F821  (plt comes from the SciCanvas plot worker)\n# Shared by the CRM code plots: the figures' plot prelude (SciCanvas 2.1), run before every plot in the app and by\n# build.js. Plots render at their printed size, so sizes below are printed points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return d * d\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n"},"journal":{"id":"cell","widthMM":174,"commercial":false,"guide":false}}