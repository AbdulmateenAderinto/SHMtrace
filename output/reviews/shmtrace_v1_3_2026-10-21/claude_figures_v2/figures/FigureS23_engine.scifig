ue},{"id":"omvlb9e8cea","type":"text","text":"unique variants","x":826.5,"y":1270,"rot":-90,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"center","w":123,"h":24,"locked":true},{"id":"omvlb9e8ceb","type":"text","text":"per 10⁵ bases","x":852.5,"y":1270,"rot":-90,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"center","w":115,"h":24,"locked":true},{"id":"omvlb9e8cec","type":"ellipse","x":1050,"y":1244.7848,"w":13,"h":13,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":1.6,"locked":true},{"id":"omvlb9e8ced","type":"ellipse","x":1066,"y":1240.63544,"w":13,"h":13,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":1.6,"locked":true},{"id":"omvlb9e8cee","type":"ellipse","x":1082,"y":1255.1765599999999,"w":13,"h":13,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":1.6,"locked":true},{"id":"omvlb9e8cef","type":"rect","x":1036.5,"y":1251.7656000000002,"w":72,"h":3.2,"rot":0,"fill":"#274b7e","stroke":"none","strokeWidth":0,"radius":0,"locked":true},{"id":"omvlb9e8ceg","type":"ellipse","x":1255,"y":1301.9276,"w":13,"h":13,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":1.6,"locked":true},{"id":"omvlb9e8ceh","type":"ellipse","x":1271,"y":1288.92224,"w":13,"h":13,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":1.6,"locked":true},{"id":"omvlb9e8cei","type":"ellipse","x":1287,"y":1301.9276,"w":13,"h":13,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":1.6,"locked":true},{"id":"omvlb9e8cej","type":"rect","x":1241.5,"y":1302.4924800000001,"w":72,"h":3.2,"rot":0,"fill":"#9a3439","stroke":"none","strokeWidth":0,"radius":0,"locked":true},{"id":"omvlb9e8cek","type":"text","text":"wild type","x":1036,"y":1345,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"center","w":73,"h":24,"locked":true},{"id":"omvlb9e8cer","type":"text","text":"Aicda","x":1242.5,"y":1351,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","italic":true,"w":48,"h":24,"locked":true},{"id":"omvlb9e8ceu","type":"text","text":"−/−","x":1286.5,"y":1345,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"left","italic":false,"w":30,"h":24,"locked":true}],"alt":"Figure S22. How SHMtrace turns reads into calls: six stages, each with its rule and equation, and the stage working on the JH4 libraries."}],"uploads":[],"assets":{},"plotStyle":{"family":"Arial","fontSize":7,"tickSize":6.6,"labelSize":7,"titleSize":7,"legendSize":6.6,"minScriptPt":6,"axisLineWidth":0.8,"lineWidth":1.4,"markerSize":4,"palette":["#274b7e","#7a4f9a","#1f6f8b","#a3621b","#9a3439","#4a5562"]},"plotPrelude":{"python":"# ruff: noqa: F821  (plt comes from the SciCanvas plot worker)\n# Shared by the CRM code plots: the figures' plot prelude (SciCanvas 2.1), run before every plot in the app and by\n# build.js. Plots render at their printed size, so sizes below are printed points.\nimport json  # noqa: F401  (each plot reads its numbers with json.loads)\n\nINK, MID, SOFT, FAINT = \"#1d2733\", \"#4a5562\", \"#8a96a3\", \"#cfd8df\"\nSH, PUB = \"#1f6f8b\", \"#a3621b\"           # SHMtrace, published\nCASE, CASEF = \"#274b7e\", \"#6d9ad0\"        # wild type\nKO, KOF = \"#7a4f9a\", \"#bda3d4\"            # knockout\nCTRL, CTRLF = \"#9a3439\", \"#d07a7e\"        # AID-null\nplt.rcParams.update({\"axes.edgecolor\": INK, \"xtick.color\": INK, \"ytick.color\": INK, \"axes.labelcolor\": MID,\n                     \"text.color\": INK})\n\n\ndef area(d):\n    \"\"\"Scatter size for a marker d printed points across.\"\"\"\n    return d * d\n\n\ndef lw(w):\n    \"\"\"A line w printed points wide.\"\"\"\n    return w\n\n\ndef plain_log(axis):\n    \"\"\"Log-axis tick labels as plain numbers (10, 100), not 10^n, whose exponents print below 6 pt.\"\"\"\n    axis.set_major_formatter(plt.FuncFormatter(lambda v, _: f\"{v:g}\"))\n    axis.set_minor_formatter(plt.NullFormatter())\n\n\ndef strip(ax, x, vals, face, edge, d=5.0, spread=0.10, marker=\"o\", zorder=3):\n    \"\"\"One group's points, spread sideways so they do not hide each other.\"\"\"\n    vals = list(vals)\n    if not vals:\n        return\n    xs = [x] if len(vals) == 1 else [x - spread + 2 * spread * k / (len(vals) - 1) for k in range(len(vals))]\n    ax.scatter(xs, vals, s=area(d), facecolor=face, edgecolor=edge, linewidth=lw(0.6), marker=marker, zorder=zorder)\n\n\ndef mean_bar(ax, x, vals, color, half=0.16):\n    vals = list(vals)\n    if vals:\n        m = sum(vals) / len(vals)\n        ax.plot([x - half, x + half], [m, m], color=color, linewidth=lw(1.3), solid_capstyle=\"butt\", zorder=4)\n"},"journal":{"id":"cell","widthMM":174,"commercial":false,"guide":false}}