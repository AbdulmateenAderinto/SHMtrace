{"version":2,"pages":[{"id":"crm-figS14","name":"Figure S22","width":1400,"height":1408,"background":"#ffffff","objects":[{"id":"omvlb9e892","type":"text","text":"How SHMtrace decides what is a call","x":20,"y":2,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":397,"h":31},{"id":"omvlb9e8al","type":"group","name":"subtitle","x":20,"y":28,"w":1007,"h":36,"w0":1007,"h0":36,"rot":0,"children":[{"id":"omvlb9e893","type":"text","text":"Every rule the engine applies, and the same rule working on the J","x":0,"y":6,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","italic":false,"w":512,"h":24},{"id":"omvlb9e896","type":"text","text":"H","x":508,"y":12,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","italic":false,"w":17,"h":24},{"id":"omvlb9e899","type":"text","text":"4 libraries (3 wild-type and 3 ","x":521,"y":6,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","italic":false,"w":228,"h":24},{"id":"omvlb9e89c","type":"text","text":"Aicda","x":745,"y":6,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","italic":true,"w":48,"h":24},{"id":"omvlb9e89f","type":"text","text":"−/−","x":789,"y":0,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","italic":false,"w":30,"h":24},{"id":"omvlb9e8ai","type":"text","text":" mice, 500 reads each).","x":815,"y":6,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","italic":false,"w":192,"h":24}]},{"id":"omvlb9e8am","type":"rect","x":20,"y":68,"w":1370,"h":2.6,"rot":0,"fill":"#1d2733","stroke":"none","strokeWidth":0,"radius":0},{"id":"omvlb9e8an","type":"rect","x":20,"y":84,"w":830,"h":202,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvlb9e8ao","type":"ellipse","x":33,"y":99,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"1","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvlb9e8ap","type":"text","text":"Read preparation","x":82,"y":104,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":172,"h":28},{"id":"omvlb9e8aq","type":"text","text":"Every read is gated before it is used. A read over the length set for its locus,","x":82,"y":140,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":592,"h":24},{"id":"omvlb9e8ar","type":"text","text":"or one whose quality scores predict more than one error in a hundred bases, is dropped.","x":82,"y":163,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":688,"h":24},{"id":"omvlb9e8as","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":206,"w":198.4,"h":50.4,"rot":0,"name":"equation 1","nw":794},{"id":"omvlb9e8at","type":"rect","x":20,"y":304,"w":830,"h":202,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvlb9e8au","type":"ellipse","x":33,"y":319,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"2","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvlb9e8av","type":"text","text":"Competitive alignment","x":82,"y":324,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":219,"h":28},{"id":"omvlb9e8aw","type":"text","text":"Each read is aligned to the target, its paralogue and any contaminant at once,","x":82,"y":360,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":606,"h":24},{"id":"omvlb9e8ax","type":"text","text":"and goes to whichever it matches best. A paralogue can also be analysed as a","x":82,"y":383,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":613,"h":24},{"id":"omvlb9e8ay","type":"text","text":"target of its own.","x":82,"y":406,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":133,"h":24},{"id":"omvlb9e8az","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":449,"w":217.1,"h":35.7,"rot":0,"name":"equation 2","nw":868},{"id":"omvlb9e8a10","type":"rect","x":20,"y":524,"w":830,"h":202,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvlb9e8a11","type":"ellipse","x":33,"y":539,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"3","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvlb9e8a12","type":"text","text":"Background measured in the controls","x":82,"y":544,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":364,"h":28},{"id":"omvlb9e8a13","type":"text","text":"The error rate is not taken from the quality scores. It is measured in the AID-null","x":82,"y":580,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":621,"h":24},{"id":"omvlb9e8a14","type":"text","text":"libraries per substitution, strand and quality, pooled over positions as a floor; a","x":82,"y":603,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":609,"h":24},{"id":"omvlb9e8a15","type":"text","text":"position whose controls err more keeps its own rate, shrunk toward the pooled one,","x":82,"y":626,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":648,"h":24},{"id":"omvlb9e8a16","type":"text","text":"and every rate is inflated by one factor fitted by leaving each control out in turn.","x":82,"y":649,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":615,"h":24},{"id":"omvlb9e8a17","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":681.9,"w":278.5,"h":36.1,"rot":0,"name":"equation 3","nw":1114},{"id":"omvlb9e8a18","type":"rect","x":20,"y":744,"w":830,"h":202,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvlb9e8a19","type":"ellipse","x":33,"y":759,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"4","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvlb9e8a1a","type":"text","text":"One test per candidate","x":82,"y":764,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":224,"h":28},{"id":"omvlb9e8a1b","type":"text","text":"Supporting reads are ranked by quality and every depth of evidence is tested","x":82,"y":800,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":600,"h":24},{"id":"omvlb9e8a1c","type":"text","text":"against that measured rate; the best test is kept and corrected for having tried","x":82,"y":823,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":606,"h":24},{"id":"omvlb9e8a1d","type":"text","text":"them all. A change carried by half the reads or more is set aside as likely germline.","x":82,"y":846,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":643,"h":24},{"id":"omvlb9e8a1e","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":889,"w":448,"h":36.7,"rot":0,"name":"equation 4","nw":1792},{"id":"omvlb9e8a1f","type":"rect","x":20,"y":964,"w":830,"h":202,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvlb9e8a1g","type":"ellipse","x":33,"y":979,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"5","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvlb9e8a1h","type":"text","text":"Threshold set by the controls themselves","x":82,"y":984,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":399,"h":28},{"id":"omvlb9e8a1i","type":"text","text":"Each control is called against the other controls, giving decoy p-values. The","x":82,"y":1020,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":589,"h":24},{"id":"omvlb9e8a1j","type":"text","text":"threshold is the largest at which the false calls the decoys predict are at most","x":82,"y":1043,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":600,"h":24},{"id":"omvlb9e8a1k","type":"text","text":"5% of the calls kept.","x":82,"y":1066,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":161,"h":24},{"id":"omvlb9e8a1l","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":1109,"w":541,"h":43.2,"rot":0,"name":"equation 5","nw":2164},{"id":"omvlb9e8a1m","type":"rect","x":20,"y":1184,"w":830,"h":202,"rot":0,"fill":"#f3f6f8","stroke":"#cdd6de","strokeWidth":1.6,"radius":10},{"id":"omvlb9e8a1n","type":"ellipse","x":33,"y":1199,"w":34,"h":34,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"label":"6","labelColor":"#ffffff","labelBold":true,"labelSize":17,"badge":true},{"id":"omvlb9e8a1o","type":"text","text":"One number per animal","x":82,"y":1204,"rot":0,"fontSize":20.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":233,"h":28},{"id":"omvlb9e8a1p","type":"text","text":"Calls are summarised per library and compared between groups on the log scale,","x":82,"y":1240,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":635,"h":24},{"id":"omvlb9e8a1q","type":"text","text":"with one value per animal, so clones of one lineage cannot stand in for","x":82,"y":1263,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":550,"h":24},{"id":"omvlb9e8a1r","type":"text","text":"independent mice.","x":82,"y":1286,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":147,"h":24},{"id":"omvlb9e8a1s","type":"image","src":"data:image/svg+xml;base64,","x":82,"y":1329,"w":480.3,"h":36.9,"rot":0,"name":"equation 6","nw":1921},{"id":"omvlb9e8a1t","type":"text","text":"A","x":880,"y":84,"rot":0,"fontSize":22.5,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":20,"h":31},{"id":"omvlb9e8a1u","type":"text","text":"The fate of every read","x":906,"y":86,"rot":0,"fontSize":19,"color":"#1d2733","family":"arial","align":"left","bold":true,"w":202,"h":26,"locked":true},{"id":"omvlb9e8a1y","type":"rect","x":1112,"y":91,"w":12,"h":12,"rot":0,"fill":"#9aa5b1","stroke":"none","strokeWidth":0,"radius":0,"locked":true},{"id":"omvlb9e8a1z","type":"text","text":"gated","x":1128,"y":86,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":48,"h":24,"locked":true},{"id":"omvlb9e8a20","type":"rect","x":1186,"y":91,"w":12,"h":12,"rot":0,"fill":"#d9952b","stroke":"none","strokeWidth":0,"radius":0,"locked":true},{"id":"omvlb9e8a21","type":"text","text":"not the target","x":1202,"y":86,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":108,"h":24,"locked":true},{"id":"omvlb9e8a22","type":"rect","x":1320,"y":91,"w":12,"h":12,"rot":0,"fill":"#1f6f8b","stroke":"none","strokeWidth":0,"radius":0,"locked":true},{"id":"omvlb9e8a23","type":"text","text":"usable","x":1336,"y":86,"rot":0,"fontSize":17.5,"color":"#4a5562","family":"arial","align":"left","w":56,"h":24,"locked":true},{"id":"omvlb9e8a24","type":"path","x":970,"y":124,"w":1,"h":112,"w0":1,"h0":112,"rot":0,"nodes":[{"x":0,"y":0},{"x":0,"y":112}],"closed":false,"fill":"none","stroke":"#1d2733","strokeWidth":1.8,"cap":"butt","locked":true},{"id":"omvlb9e8a25","type":"path","x":970,"y":236,"w":410,"h":1,"w0":410,"h0":1,"rot":0,"nodes":[{"x":0,"y":0},{"x":410,"y":0}],"closed":false,"fill":"none","stroke":"#1d2733","strokeWidth":1.8,"cap":"butt","locked":true},{"id":"omvlb9e8a26","type":"path","x":964,"y":236,"w":6,"h":1,"w0":6,"h0":1,"rot":0,"nodes":[{"x":0,"y":0},{"x":6,"y":0}],"closed":false,"fill":"none","stroke":"#1d2733","strokeWidth":1.8,"cap":"butt","locked":true},{"id":"omvlb9e8a27","type":"text","text":"0","x":947,"y":226,"rot":0,"fontSize":17.5,"color":"#1d2733","family":"arial","align":"right","w":14,"h":24,"locked":true},{"id":"omvlb9e8a28","type":"path","x":964,"y":182,"w":6,"h":1,"w0":6,"h0":1,"rot":0,"nodes":[{"x":0,"y":0},{"x":6,"y":0}],"closed":false,"fill":"none","stroke":"#1d2733","strokeWidth":1.8,"cap":"butt","locked":true},{"id":"om