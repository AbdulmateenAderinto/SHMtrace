":630,"w":297.3333333333333,"h":340,"rot":0,"fill":"#ffffff","stroke":"#b4bec8","strokeWidth":2.4,"radius":14},{"id":"omvlbq2m5r","type":"text","text":"Low background","x":75.16666666666666,"y":648,"rot":0,"fontSize":26,"color":"#1d2733","family":"arial","align":"center","bold":true,"w":207,"h":35},{"id":"omvlbq2m5s","type":"rect","x":351.3333333333333,"y":630,"w":297.3333333333333,"h":340,"rot":0,"fill":"#ffffff","stroke":"#b4bec8","strokeWidth":2.4,"radius":14},{"id":"omvlbq2m5t","type":"text","text":"Pooled spectra","x":406,"y":648,"rot":0,"fontSize":26,"color":"#1d2733","family":"arial","align":"center","bold":true,"w":188,"h":35},{"id":"omvlbq2m5u","type":"rect","x":672.6666666666666,"y":630,"w":297.3333333333333,"h":340,"rot":0,"fill":"#ffffff","stroke":"#b4bec8","strokeWidth":2.4,"radius":14},{"id":"omvlbq2m5v","type":"text","text":"Clones and trees","x":714.8333333333333,"y":648,"rot":0,"fontSize":26,"color":"#1d2733","family":"arial","align":"center","bold":true,"w":213,"h":35},{"id":"omvlbq2m5w","type":"ellipse","x":93,"y":721,"w":18,"h":18,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":2},{"id":"omvlbq2m5x","type":"ellipse","x":111,"y":739,"w":18,"h":18,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":2},{"id":"omvlbq2m5y","type":"ellipse","x":129,"y":757,"w":18,"h":18,"rot":0,"fill":"#6d9ad0","stroke":"#274b7e","strokeWidth":2},{"id":"omvlbq2m5z","type":"rect","x":80,"y":746.3,"w":80,"h":3.4,"rot":0,"fill":"#274b7e","stroke":"none","strokeWidth":0,"radius":1.7},{"id":"omvlbq2m510","type":"ellipse","x":213,"y":839,"w":18,"h":18,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":2},{"id":"omvlbq2m511","type":"ellipse","x":231,"y":845,"w":18,"h":18,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":2},{"id":"omvlbq2m512","type":"ellipse","x":249,"y":849,"w":18,"h":18,"rot":0,"fill":"#d07a7e","stroke":"#9a3439","strokeWidth":2},{"id":"omvlbq2m513","type":"rect","x":200,"y":851.6333333333333,"w":80,"h":3.4,"rot":0,"fill":"#9a